            updateTableOfContent: function () {
                this.isProcessingData = true;
                if (this.reportID > 0) {
                    if (confirm('Would you like to save data ?')) {
                        this.save();
                    }
                    fetch('/admin/report/SaveTableOfContent', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json; charset=utf-8'
                        },
                        body: JSON.stringify({
                            reportID: this.reportID,
                            tableOfContent: this.$refs.toclist.innerHTML,
                            listOfFigures: this.$refs.lof.innerHTML,
                            listOfTables: this.$refs.lot.innerHTML
                        })
                    }).then(res => res.json())
                        .then(res => {
                            this.isProcessingData = false;
                        });
                } else {
                    alert('Report ID is not valid!!');
                }
            },
            save: function () {
                this.isProcessingData = true;

                if (this.reportID == 0) {
                    alert('Report Id is not valid!!');
                    return;
                }

                let sendData = [{
                    ColumnName: 'Keyword',
                    ColumnValue: this.Keyword,
                    ReportID: this.reportID
                }, {
                    ColumnName: 'Revenue',
                    ColumnValue: this.Revenue,
                    ReportID: this.reportID
                }, {
                    ColumnName: 'Volume',
                    ColumnValue: this.Volume,
                    ReportID: this.reportID
                }, {
                    ColumnName: 'FromYear',
                    ColumnValue: this.FromYear,
                    ReportID: this.reportID
                }, {
                    ColumnName: 'ToYear',
                    ColumnValue: this.ToYear,
                    ReportID: this.reportID
                }, {
                    ColumnName: 'BaseYear',
                    ColumnValue: this.BaseYear,
                    ReportID: this.reportID
                }, {
                    ColumnName: 'Drivers',
                    ColumnValue: this.Drivers.map(d => { return d.itemText.trim(); }).join('|'),
                    ReportID: this.reportID
                }, {
                    ColumnName: 'Restraints',
                    ColumnValue: this.Restraints.map(r => { return r.itemText.trim(); }).join('|'),
                    ReportID: this.reportID
                }, {
                    ColumnName: 'Opportunities',
                    ColumnValue: this.Opportunities.map(o => { return o.itemText.trim(); }).join('|'),
                    ReportID: this.reportID
                }, {
                    ColumnName: 'Challenges',
                    ColumnValue: this.Chalanges.map(c => { return c.itemText.trim(); }).join('|'),
                    ReportID: this.reportID
                }, {
                    ColumnName: 'Players',
                    ColumnValue: this.Company.map(c => { return c.CompanyName.trim(); }).join('|'),
                    ReportID: this.reportID
                }, ...this.Segment.SubSegment.map(s => {
                    return {
                        ColumnName: 'Segment',
                        ColumnValue: s.SegmentName,
                        ReportID: this.reportID,
                        Child: s.SubSegment.map(ss => {
                            return {
                                ColumnName: 'SubSegment',
                                ColumnValue: ss.SegmentName,
                                ReportID: this.reportID
                            };
                        })
                    };
                })];



                fetch('/admin/report/InsertOrUpdateReportData', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json; charset=utf-8'
                    },
                    body: JSON.stringify({
                        reportID: this.reportID,
                        reportData: sendData
                    })
                }).then(res => res.json())
                    .then(res => {
                        if (res && res.Success) {
                            alert('Data has been saved!!');
                        }
                    });
            },
            getReportData: function () {
                fetch(`/admin/report/GetReportData?reportID=${this.reportID}`, {
                    method: 'GET',

                }).then(res => res.json())
                    .then(res => {
                        console.log(res);

                        let dbRevenue = filterValue('Revenue', res);
                        
                        this.Revenue = dbRevenue[0].ColumnValue;

                        let dbVolume = filterValue('Volume', res);
                        this.Volume = dbVolume[0].ColumnValue;

                        let dbFromYear = filterValue('FromYear', res);
                        this.FromYear = dbFromYear[0].ColumnValue;

                        let dbToYear = filterValue('ToYear', res);
                        this.ToYear = dbToYear[0].ColumnValue;

                        let dbBaseYear = filterValue('BaseYear', res);
                        this.BaseYear = dbBaseYear[0].ColumnValue;

                        let dbKeyword = filterValue('Keyword', res);
                        this.Keyword = dbKeyword[0].ColumnValue;

                        let dbDrivers = filterValue('Drivers', res);
                        this.drivers = dbDrivers[0].ColumnValue?.replace('|', ',');

                        let dbRestraints = filterValue('Restraints', res);
                        this.restraints = dbRestraints[0].ColumnValue?.replace(/\|/igm, ',');

                        let dbOpportunities = filterValue('Opportunities', res);
                        this.opportunities = dbOpportunities[0].ColumnValue?.replace(/\|/igm, ',');

                        let dbChallenges = filterValue('Challenges', res);
                        this.chalanges = dbChallenges[0].ColumnValue?.replace(/\|/igm, ',');

                        let dbSegment = filterValue('Segment', res);
                        let dbSubSegment = filterValue('SubSegment', res);
                        this.Segment.SubSegment = [];
                        dbSegment.forEach(s => {
                            this.Segment.SubSegment.push({
                                SegmentName: s.ColumnValue,
                                SubSegment: []
                            });
                            let subSegments = dbSubSegment.filter(x => {
                                console.log(s.Id);
                                return x.ParentID == s.ID;
                            });
                            subSegments[0].ColumnValue.split(',').forEach(y => {
                                this.Segment.SubSegment[this.Segment.SubSegment.length - 1].SubSegment.push({
                                    SegmentName: y.trim()
                                });
                            });
                        });

                        let dbPlayers = filterValue('Players', res);
                        this.Companies = dbPlayers[0].ColumnValue?.replace(/\|/igm, ',');
                    });
            }
        },
        components: {
            'tocTemplate': tocTemplate
        },
        mounted: function () {
            let urlFragments = window.location.href.split('/');
            this.reportID = parseInt(urlFragments[urlFragments.length - 1]);
            if (this.reportID > 0) {
                this.getReportData();
            }
        }
    });
    var tocTemplate = vm.component('TocTemplate', {
        template: '#toc-template',
        props: {
            item: [],
            parentindex: 0,
        },
        mounted: function () {

        },
        data: function () {
            return {

            }
        }
    });
    vm.mount('#generateTOC');

    function filterValue(columnName, data) {
        return data.filter(x => {
            return x.ColumnName == columnName;
        });
    }
</script>


