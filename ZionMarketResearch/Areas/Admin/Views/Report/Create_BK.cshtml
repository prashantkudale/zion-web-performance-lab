<script>
    var tableApp = new Vue({
        el: '#tableApp',
        data: {
            tableData: [],
            disableAddButton: false,
            disableDeleteButton: false
        },
        methods: {
            addRow: function () {

                //Vue.nextTick(function () {
                //    $("textarea.editor").each(function (ind, item) {
                //        if (CKEDITOR.instances[this.id]) {

                //        } else {
                //            CKEDITOR.replace(this.id);
                //        }
                //    });
                //});
                //this.ApplyCkEditor();
                this.tableData.push({ Question: '', Answer: '' });
                Vue.nextTick(function () {
                    CKEDITOR.replace('editor_' + (tableApp.tableData.length - 1));
                });
            },
            RemoveRow: function (rowNumber) {
                if (typeof CKEDITOR.instances['editor_' + rowNumber] != 'undefined')
                    CKEDITOR.instances['editor_' + rowNumber].destroy(true);
                tableApp.tableData.splice(rowNumber, 1);
                if (tableApp.tableData.length >= (rowNumber - 1)) {
                    Vue.nextTick(function () {
                        CKEDITOR.replace('editor_' + rowNumber);
                    });
                }
            },
            ApplyCkEditor: function () {
                Vue.nextTick(function () {
                    //$("textarea.editor").each(function (ind, item) {
                    //    if (typeof CKEDITOR.instances[item.id] != 'undefined')
                    //        CKEDITOR.instances[item.id].destroy(true);
                    //});

                    $("textarea.editor").each(function (ind, item) {
                        CKEDITOR.replace(item);
                        debugger;
                        if (item.value != '') {
                            CKEDITOR.instances[item.id].setContent(item.value);
                        }
                    });
                });
            }
        }
    });

</script>
