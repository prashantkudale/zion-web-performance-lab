                }
                ddl.html(htm);
            },
            refreshUrl: "/admin/category/getparentcategories"
        });

        $('button').click(function (e) {
            if (jsFormValidation("#frmReport", null, null, null)) {
                var bread = $("#CategoryId");
                bread.val(selectionValue[selectionValue.length - 1]);
                $("#frmReport").submit();
            } else {
                e.preventDefault();
            }
        });
        $("#PublishedDate").datepicker({
            dateFormat: "dd-MM-yy"
        });
    });
    function jsChnageTitle(ctl) {
        $("#lblTitle").text($(ctl).val());
