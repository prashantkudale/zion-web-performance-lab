@model ZionAdmin.Repository.ReportRepository
@{
    ViewBag.Title = "Create Report";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<h3>Create Report</h3>
<hr />
<div class="col-md-12">
