@model ZionAdmin.Repository.NewsRepository
@{
    ViewBag.Title = "Edit News";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h3>Edit News</h3>
<hr />
<div class="md-col-12">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert @(ViewBag.ErrorMessage.Contains("true") ? "alert-danger" : "alert-success")">
            @Html.ValidationSummary()
        </div>
    }

    @using (Html.BeginForm("edit", "news", FormMethod.Post, new { id = "frmNews", Class = "form-horizontal", enctype = "multipart/form-data" }))
    {
        @Html.HiddenFor(n => n.NewsId)
        <div class="form-group">
            <label for="CategoryName" class="control-label col-sm-2">Title</label>
            <div class="col-sm-10">
                @Html.TextBoxFor(n => n.NewsTitle, new { Class = "form-control", placeholder = "Title whithout special characters. Do not enter (.,#*&!@$)%^(&*)+=_" })
                @Html.ValidationMessageFor(r => r.NewsTitle)
            </div>
        </div>
        <div class="form-group">
            <label for="CategoryName" class="control-label col-sm-2">URL</label>
            <div class="col-sm-10">
                @Html.TextBoxFor(n => n.NewsUrl, new { Class = "form-control", placeholder = "Leave blank if you want default URL." })
                @Html.ValidationMessageFor(r => r.NewsUrl)
            </div>
        </div>
        <div class="form-group">
            <label for="CategoryName" class="control-label col-sm-2">Meta Title</label>
            <div class="col-sm-10">
                @Html.TextBoxFor(n => n.MetaTitle, new { Class = "form-control" })
                @Html.ValidationMessageFor(r => r.MetaTitle)
            </div>
        </div>
        <div class="form-group">
            <label for="CategoryName" class="control-label col-sm-2">Meta Description</label>
            <div class="col-sm-10">
                @Html.TextAreaFor(n => n.MetaDescription, new { Class = "form-control" })
                @Html.ValidationMessageFor(r => r.MetaDescription)
            </div>
        </div>
        <div class="form-group">
            <label for="CategoryName" class="control-label col-sm-2">Meta Keywords</label>
            <div class="col-sm-10">
                @Html.TextBoxFor(n => n.MetaKeywords, new { Class = "form-control" })
                @Html.ValidationMessageFor(r => r.MetaKeywords)
            </div>
        </div>
        
        <div class="form-group" style="display:none;">
            <label for="CategoryName" class="control-label col-sm-2">News Image</label>
            <div class="col-sm-10">
                <input type="file" name="File1" onchange="jsGetFileName(this, 'hdnMainPageImage');" />
                @if (Model != null && !string.IsNullOrEmpty(Model.MainPageImagePath))
                {
                    <img src="/UploadFiles/@Model.MainPageImagePath" style="height:50px; width:100px;" id="img1" />
                    <span class="fa fa-times" style="cursor: pointer;" title="Remove Image" onclick="jsRemoveImage('hdnMainPageImage', 'img1', this);">Remove</span>
                    @Html.HiddenFor(r => r.MainPageImagePath, new { id = "hdnMainPageImage" })
                }

            </div>
        </div>
        <div class="form-group">
            <label for="CategoryName" class="control-label col-sm-2">News</label>
            <div class="col-sm-10">
                @Html.TextAreaFor(n => n.Description, new { Class = "form-control" })
                @Html.ValidationMessageFor(r => r.Description)
            </div>
        </div>
        <div class="form-group" style="display:none;">
            <label for="CategoryName" class="control-label col-sm-2">Search Image</label>
            <div class="col-sm-10">
                <input type="file" name="File2" onchange="jsGetFileName(this, 'hdnSearchPageImage');" />
                @if (Model != null && !string.IsNullOrEmpty(Model.SearchPageImagePath))
                {
                    <img src="/UploadFiles/@Model.SearchPageImagePath" style="height:50px; width:100px;" id="img2" />
                    <span class="fa fa-times" style="cursor: pointer;" title="Remove Image" onclick="jsRemoveImage('hdnSearchPageImage', 'img2', this);">Remove</span>
                    @Html.HiddenFor(r => r.SearchPageImagePath, new { id = "hdnSearchPageImage" })
                }

            </div>
        </div>
        <div class="form-group" style="display:none;">
            <label for="CategoryName" class="control-label col-sm-2">Search Description</label>
            <div class="col-sm-10">
                @Html.TextAreaFor(n => n.SearchPageDescription, new { Class = "form-control" })
                @Html.ValidationMessageFor(r => r.SearchPageDescription)
            </div>
        </div>
        <div class="form-group">
            <label for="CategoryName" class="control-label col-sm-2">Published Date</label>
            <div class="col-sm-10">
                @Html.TextBoxFor(n => n.PublishedDate, "{0:dd-MMM-yyyy}", new { Class = "form-control" })
                @Html.ValidationMessageFor(r => r.PublishedDate)
            </div>
        </div>
        <div class="form-group">
            <label for="CategoryName" class="control-label col-sm-2">Published By</label>
            <div class="col-sm-10">
                @Html.TextBoxFor(n => n.PublishedBy, new { Class = "form-control", placeholder = "Enter name of published, leave blank if default is needed." })
                @Html.ValidationMessageFor(r => r.PublishedBy)
            </div>
        </div>
        <div class="form-group">
            <label for="CategoryName" class="control-label col-sm-2">Report URL</label>
            <div class="col-sm-10">
                @Html.TextBoxFor(n => n.ReportUrl, new { Class = "form-control" })
                @Html.ValidationMessageFor(r => r.ReportUrl)
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-sm-2">Is Article?</label>
            <div class="col-sm-10 checkbox">
                <label>@Html.CheckBoxFor(r => r.IsArticle) (select if this is article.)</label>
                @Html.ValidationMessageFor(r => r.IsArticle)
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-sm-2">Is Active</label>
            <div class="col-sm-10">
                <div class="material-switch pull-left">
                    <input type="checkbox" id="IsActive" name="IsActive" value="true"  @(Model.IsActive ? "checked" : "")/>
                    <label for="IsActive" class="label-success" style="margin-top:16px;"></label>
                    @Html.ValidationMessageFor(r => r.IsActive)
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <button type="button" class="btn btn-primary">Submit</button>
                <a href="@Url.Action("index", "news")" class="btn btn-default">Cancel</a>
            </div>
        </div>
    }
</div>
<script src="https://cdn.ckeditor.com/4.5.2/standard-all/ckeditor.js"></script>
<script>
    CKEDITOR.replace('Description', { height: 500 });
    CKEDITOR.replace('SearchPageDescription');
    $(document).ready(function () {
        $('button').click(function (e) {
            if (jsFormValidation("#frmNews", null, null, null)) {
                $("#frmNews").submit();
            } else {
                e.preventDefault();
            }
        });
        $("#PublishedDate").datepicker({
            dateFormat: 'dd-MM-yy'
        });
    });
    function jsRemoveImage(hiddenId, ImgId, ctl) {
        $("#" + hiddenId).val("");
        $("#" + ImgId).hide();
        $(ctl).hide();
    }
    function jsGetFileName(ctl, hdnCtl) {
        var filePath = $(ctl).val();
        var sep = filePath.split("\\");
        $("#" + hdnCtl).val(sep[sep.length - 1]);
    }

</script>
<link href="~/Areas/Admin/Content/css/switch.css" rel="stylesheet" />