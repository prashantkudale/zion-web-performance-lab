@model PagedList.IPagedList<ZionAdmin.Repository.CategoryRepository>
@using PagedList.Mvc
@{
    ViewBag.Title = "Category List";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h3>Category</h3>
<hr />
<div class="col-md-12">
    <div class="row margin-bottom-15">
        <div class="row margin-bottom-15">
            <a href="@Url.Action("create", "category")">Create New</a>
        </div>
        @using (Html.BeginForm("search", "category", FormMethod.Get, new { Class = "form-inline" }))
        {

            <div class="input-group col-md-12">
                <input type="text" name="id" class="form-control" placeholder="Search" id="searchText" value="@ViewBag.SearchText" />
                <span class="input-group-btn" style="width: 70px !important;">
                    <button type="submit" class="btn btn-primary">Search</button>
                </span>
            </div>

        }
    </div>
    <div class="row">
        <table class="table table-bordered">
            <thead class="thead-inverse">
                <tr>
                    <th>Category</th>
                    <th>Category Url</th>
                    <th colspan="2">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model)
                {
                    <tr>
                        <td>@cat.CategoryName</td>
                        <td>@cat.CategoryUrl</td>
                        <td><a href="@Url.Action("edit", "category", new { id = cat.CategoryId })">Edit</a></td>
                        <td><a href="@Url.Action("delete", "category", new { id = cat.CategoryId })">Delete</a></td>
                    </tr>
                }
            </tbody>
        </table>
        @Html.PagedListPager(Model, x => "/admin/category/index/" + x)
    </div>

</div>

<script>
    var searchValue = $("#searchText").val();
    var isSearched = searchValue != null && searchValue != "";

    $('.pagination li a').each(function (index) {
        if (isSearched) {
            $(this).attr("href", "/admin/category/search?id=" + searchValue + "&page=" + $(this).text());
            $(".PagedList-skipToNext > a").attr("href", "/admin/category/search?id=" + searchValue + "&page=" + (parseInt($(".pagination .active").text()) + 1));
            $(".PagedList-skipToPrevious > a").attr("href", "/admin/category/search?id=" + searchValue + "&page=" + (parseInt($(".pagination .active").text()) - 1));
        }
    });
</script>