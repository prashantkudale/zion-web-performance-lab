@model ZionAdmin.Repository.PaymentLinkRepository
@{
    ViewBag.Title = "Create Payment Link";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h4>Create Payment Link</h4>
<hr/>
<div class="col-md-12">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert @(ViewBag.ErrorMessage.Contains("true") ? "alert-danger" : "alert-success")">
            @Html.ValidationSummary()
        </div>
    }
    @using (Html.BeginForm("Create", "PaymentLink", FormMethod.Post, new { Class = "form-horizontal", id = "frmPaymentLink" }))
    {
        <div class="form-group">
            <label for="MetaDescription" class="control-label col-sm-2">Report Url</label>
            <div class="col-sm-10 input-group">
                @Html.TextBoxFor(p => p.ReportUrl, new { Class = "form-control" })
                @Html.ValidationMessageFor(p => p.ReportUrl)
            </div>
        </div>
        <div class="form-group">
            <label for="MetaDescription" class="control-label col-sm-2">Single User</label>
            <div class="col-sm-10 input-group">
                <span class="input-group-addon">$</span>
                @Html.TextBoxFor(p => p.SingleUser, new { Class = "form-control" })
                @Html.ValidationMessageFor(p => p.SingleUser)
            </div>
        </div>
        <div class="form-group">
            <label for="MetaDescription" class="control-label col-sm-2">Multi User</label>
            <div class="col-sm-10 input-group">
                <span class="input-group-addon">$</span>
                @Html.TextBoxFor(p => p.MultiUser, new { Class = "form-control" })
                @Html.ValidationMessageFor(p => p.MultiUser)
            </div>
        </div>
        <div class="form-group">
            <label for="MetaDescription" class="control-label col-sm-2">Corporate User</label>
            <div class="col-sm-10 input-group">
                <span class="input-group-addon">$</span>
                @Html.TextBoxFor(p => p.CorporateUser, new { Class = "form-control" })
                @Html.ValidationMessageFor(p => p.CorporateUser)
            </div>
        </div>
        <div class="form-group">
            <label for="MetaDescription" class="control-label col-sm-2">Valid To</label>
            <div class="col-sm-10 input-group">
                @Html.TextBoxFor(p => p.ValidTo, new { Class = "form-control" })
                @Html.ValidationMessageFor(p => p.ValidTo)
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <button type="button" class="btn btn-primary">Submit</button>
                <a href="@Url.Action("index", "paymentlink")" class="btn btn-default">Cancel</a>
            </div>
        </div>
    }
</div>
<script>
    $(document).ready(function () {
        $('button').click(function (e) {
            if (jsFormValidation("#frmPaymentLink", null, null, null)) {
                $("#frmPaymentLink").submit();
            } else {
                e.preventDefault();
            }
        });
        $("#ValidTo").datepicker({
            dateFormat: 'dd-M-yy'
        });
    });
</script>