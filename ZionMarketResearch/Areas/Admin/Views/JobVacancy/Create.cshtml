@model ZionMarketResearch.Areas.Admin.Repository.VacancyEntity
@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h3>Create Job Vacancy</h3>
@Html.ValidationSummary()
<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm("Create", "JobVacancy", FormMethod.Post))
        {
            <div class="form-group">
                <label>Job Title</label>
                @Html.TextBoxFor(model => model.JobTitle, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.JobTitle)
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Interview From Date</label>
                        @Html.TextBoxFor(model => model.InterviewDate, new { @class = "form-control", id = "txtInterviewDate" })
                        @Html.ValidationMessageFor(model => model.InterviewDate)
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Interview To Date</label>
                        @Html.TextBoxFor(model => model.InterviewDateTo, new { @class = "form-control", id = "txtInterviewToDate" })
                        @Html.ValidationMessageFor(model => model.InterviewDateTo)
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Interview From Time</label>
                        @Html.TextBoxFor(model => model.InterviewFromTime, new { @class = "form-control", id = "txtInterviewFromTime" })
                        @Html.ValidationMessageFor(model => model.InterviewFromTime)
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Interview To Time</label>
                        @Html.TextBoxFor(model => model.InterviewToTime, new { @class = "form-control", id = "txtInterviewToTime" })
                        @Html.ValidationMessageFor(model => model.InterviewToTime)
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Number Of Vacancies</label>
                        @Html.TextBoxFor(model => model.NumberOfVacancies, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.NumberOfVacancies)
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>
                            <input type="checkbox" value="true" name="CanFresherApply" /> Can Fresher Apply?
                        </label>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Location</label>
                        @Html.TextBoxFor(model => model.Location, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Location)
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Minimum Years Of Experience</label>
                        @Html.TextBoxFor(model => model.MinYearExperience, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.MinYearExperience)
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Maximum Years Of Experience</label>
                        @Html.TextBoxFor(model => model.MaxYearExperience, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.MaxYearExperience)
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label>Job Description</label>
                @Html.TextAreaFor(model => model.JobDescription, new { @class = "form-control", @id = "jobDescritpionId" })
                @Html.ValidationMessageFor(model => model.JobDescription)
            </div>

            <button type="submit" class="btn btn-primary">Submit</button>
            <a href="@Url.Action("index", "JobVacancy")" class="btn btn-default">Cancel</a>

        }
    </div>
</div>
<script src="https://cdn.ckeditor.com/4.5.2/standard-all/ckeditor.js"></script>
<link href="~/css/jquery.timepicker.min.css" rel="stylesheet" />
<script src="~/js/jquery.timepicker.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $(".txtCalender").datepicker();
        CKEDITOR.replace('jobDescritpionId');
        $("#txtInterviewDate").datepicker();
        $("#txtInterviewToDate").datepicker();
        $("#txtInterviewFromTime").timepicker();
        $("#txtInterviewToTime").timepicker();
    });
</script>