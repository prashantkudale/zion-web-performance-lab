@model ZionMarketResearch.Models.NewsDeatils
@{ ViewBag.Title = !string.IsNullOrEmpty(Model.MetaTile) ? Model.MetaTile : Model.NewsTitle;
    ViewBag.MetaDescription = !string.IsNullOrEmpty(Model.MetaDescription) ? Model.MetaDescription : Model.NewsTitle;
    ViewBag.MetaKeywords = !string.IsNullOrEmpty(Model.MetaKeywords) ? Model.MetaKeywords : Model.NewsTitle;
    Layout = "~/Views/Shared/_LayoutOneCss.cshtml"; }

    <!--
    All page-specific styles moved here (single
    block).
    Avoids multiple style recalculation passes the browser would otherwise
    trigger when encountering <style > tags spread across partial views.
    -->
    <style>
    .pulse-button {
        position: relative;
        padding: 15px 30px !important;
        border: none;
        box-shadow: 0 0 0 0 rgba(255,191,9,.7);
        border-radius: 25px;
        font-weight: bold;
        font-size: 17px;
        background-color: #ffbf09;
        cursor: pointer;
        animation: pulse 1.25s infinite cubic-bezier(.66,0,0,1);
        color: black;
    }

    .pulse-button:hover {
        animation: none;
        color: #fff;
    }

    #news_section {
        padding-top: 10px;
        background: #e7ecea;
    }

        #news_section h3,
        .benefits-bg h3 {
            color: #084f72;
        }

        #news_section .news_bg {
            padding-top: 10px;
            background: #fff;
            margin-bottom: 20px;
        }

    div#news {
        border: 1px solid #ddd;
        padding: 15px;
        margin-bottom: 15px;
    }

    #news ul li {
        margin-left: 20px;
    }

    .sub_heading {
        color: #23527c;
        font-size: 17px !important;
    }

    #news_section a {
        color: #337ab7 !important;
    }

        #news_section a.hvr-wobble-vertical {
            color: #fff !important;
        }

    #news_section h1.page_title {
        font-size: 50px !important;
    }

    #news_section .newsButton img {
        display: inline !important;
        margin-right: 10px;
    }

    #news_section .imgButton {
        text-align: center;
        margin-top: 10px;
        margin-bottom: 22px;
    }

    #news_section a.newsButton {
        margin-right: 30px;
        text-decoration: none;
    }

    #news_section .btn-hot {
        color: #fff !important;
        background-color: #db5566;
        border-bottom: 2px solid #af4451;
    }

    #news_section .btn-buynow {
        background-color: #F50057;
        border-color: #F50057;
        color: #fff !important;
    }

    #news_section .btn-primary {
        color: #fff !important;
    }

    #news_section h3 {
        font-family: 'Open Sans', sans-serif;
        font-size: 22px !important;
    }
        #report-title {
            position: relative;
            overflow: hidden;
            min-height:220px;
        }

        .lcp-bg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.4;
            z-index: 0;
            max-width: 100% !important;
            margin: 0 !important;
            border-radius: 0 !important;
        }

        #report-title .container {
            position: relative;
            z-index: 1;
        }
</style>

    <section id="report-title" class="white_section section_gap">
        <img src="/images/images06.webp"
             class="lcp-bg"
             fetchpriority="high"
             loading="eager"
             width="1200"
             height="400"
             alt="banner">
        @{ Html.RenderPartial("_NewSearch"); }
        <div class="container">
            @{ Html.RenderPartial("_breadcrumb", (Model.IsArticle ? "<a href='/all-articles'>Article</a>|" : "<a href='/all-news'>News</a>|") + Model.NewsTitle); }
            <div class="heading">
                <div class="col-sm-12">
                    <h1 class="reporttitle"> @Model.NewsTitle</h1>
                </div>
            </div>
        </div>
    </section>

<section id="news_section">
    <div class="container">
        <div class="col-sm-12 news_bg tab">
            <p class="publishedDate"><strong style="color:#23527c;"><i class="fa fa-calendar"></i> @Model.PublishedDate.Value.ToString("dd-MMM-yyyy") | Zion Market Research</strong></p>
            <div id="news" class="tab-content" style="text-align:justify;">
                @Html.Raw(Model.Description)
            </div>
        </div>
    </div>
</section>

@if (Model.ReportId != null && Model.ReportId > 0) { Html.RenderPartial("~/Views/Report/_PopForm.cshtml", new ZionMarketResearch.Models.AvailPDF { ReportId = (int)Model.ReportId, ReportTitle = Model.ReportTitle }); }

@section metaTags{
    <!-- Social sharing meta is already in the layout; nothing extra needed here. -->
}

@section NewsIndexScript
{
    <!--
    Structured data — placed early in section so crawlers find it
    without executing JS.
    -->
    <script type="application/ld+json">
        {
            "@@context": "http://www.schema.org/",
            "@@type": "@(Model.IsArticle ? "Article" : "NewsArticle")",
            "name": "@Model.NewsTitle",
            "headline":"@Model.NewsTitle",
            "image":{"@@type": "ImageObject","url":"https://www.zionmarketresearch.com/images/zionLogo01.png", "height": "200px", "width": "200px"},
            "author":
            {
            "@@type": "Organization",
            "logo": {"@@type": "ImageObject","url":"https://www.zionmarketresearch.com/images/zionLogo01.png"},
            "name": "Zion Market Research",
            "url": "https://www.zionmarketresearch.com/@(Model.IsArticle ? Url.Action("AllNews", "News") : Url.Action("AllArticles", "Article"))"
            },
            "publisher":
            {
            "@@type": "Organization",
            "name": "Zion Market Research",
            "logo": {"@@type": "ImageObject","url":"https://www.zionmarketresearch.com/images/zionLogo01.png"}
            },
            "articleBody": "@Html.Raw(Model.Description.Substring(0, Model.Description.IndexOf("</p>")).Replace("<p>", string.Empty).Replace("</p>", string.Empty).Replace("\"", "'"))",
            "datePublished": "@Model.PublishedDate.Value.ToString("yyyyMMdd")",
            "url": "https://zionmarketresearchstore.com/@(Model.IsArticle ? "article" : "news")/@Model.NewsUrl",
            "dateModified": "@Model.PublishedDate.Value.ToString("yyyyMMdd")",
            "mainEntityOfPage":"https://www.zionmarketresearch.com/news/@Model.NewsUrl"
        }
    </script>

    <!-- Form validation bundle — deferred, only needed when popup is shown -->
    <script defer src="@BundleTable.Bundles.ResolveBundleUrl("~/bundles/form-validation")"></script>
    <script defer src="~/Scripts/serializeform.js"></script>

    <script>
    // ─── News image fix ───────────────────────────────────────────────────────
    // Uses requestAnimationFrame so layout reads happen AFTER first paint,
    // preventing a forced reflow / layout thrash on page load.
    // Single consolidated $(document).ready — no nested $(function(){...}) wrapper.
    $(function () {
        requestAnimationFrame(function () {
            var imgs = document.querySelectorAll('#news img');
            for (var i = 0; i < imgs.length; i++) {
                imgs[i].classList.add('img-responsive');
                imgs[i].style.margin = '0 auto';
            }
            // word-break via CSS class is preferred; keep JS fallback minimal
            var links = document.querySelectorAll('#news_section a');
            for (var j = 0; j < links.length; j++) {
                links[j].style.wordBreak = 'break-all';
            }
        });
    });

    // ─── Popup form logic ────────────────────────────────────────────────────
    (function () {
        var savedInfo = false;

        // Cookie helpers
        function setCookie(name, value, hours) {
            var d = new Date();
            d.setTime(d.getTime() + hours * 3600000);
            document.cookie = name + '=' + value + ';expires=' + d.toUTCString() + ';path=/';
        }
        function getCookie(name) {
            var prefix = name + '=';
            var parts  = decodeURIComponent(document.cookie).split(';');
            for (var i = 0; i < parts.length; i++) {
                var c = parts[i].trim();
                if (c.indexOf(prefix) === 0) return c.slice(prefix.length);
            }
            return '';
        }

        // Expose SubmitForm globally (called from inline onclick in _PopForm)
        window.SubmitForm = function (ctl) {
            if (!$('#frmAvailPDF').valid()) return;
            if (ctl) { $(ctl).text('Processing...').prop('disabled', true); }
            $.ajax({
                url: '/form/SubmitSampleRequest',
                type: 'POST',
                data: JSON.stringify($('#frmAvailPDF').serializeFormJSON()),
                contentType: 'application/json;charset=utf-8',
                dataType: 'json',
                success: function (res) {
                    if (ctl) { $(ctl).text('Submit').prop('disabled', false); }
                    $('.alert').remove();
                    if (res && res.Success) {
                        if (window.gtag) gtag('event', 'page_view', { page_path: '/thankyou/@Model.ReportId?src=popup' });
                        $('#frmAvailPDF').hide();
                        $('.success-message').show();
                        $('.modal-footer').show();
                        setCookie('PopForm', '@Model.ReportId', 1);
                    } else {
                        $('.showMessage').html("<div class='alert alert-danger'>Error submitting form. Please try again.</div>");
                    }
                    savedInfo = true;
                },
                error: function (err) {
                    if (ctl) { $(ctl).text('Submit').prop('disabled', false); }
                    $('.showMessage').html("<div class='alert alert-danger'>" + (err.message || 'Unknown error') + "</div>");
                }
            });
        };

        $(function () {
            // Hide success/footer until form submits
            $('.success-message').hide();
            $('.modal-footer').hide();

            // ── Popup trigger: show 10 s after window load ──
            // Use a single window-load listener; do NOT nest inside $(document).ready
            $(window).one('load', function () {
                
                var rID = getCookie('PopForm');
                setTimeout(function () {
                    if (!savedInfo && rID !== '@Model.ReportId') {
                       
                        $('#mypopreqModal').modal('show');

                        // Lazy-load country only when popup is actually displayed
                        // Avoids an AJAX call on every page load for every visitor
                        $.ajax({
                            url: '/form/GetCountry',
                            type: 'GET',
                            success: function (json) {
                                $('#mypopreqModal #Country').val(json.Response.country);
                            },
                            error: function () { /* silent fail — country is optional */ }
                        });
                    }
                }, 10000);
            });
        });
    })();
    </script>
}
