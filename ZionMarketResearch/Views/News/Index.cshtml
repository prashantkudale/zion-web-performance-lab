@model ZionMarketResearch.Models.NewsDeatils
@{ ViewBag.Title = !string.IsNullOrEmpty(Model.MetaTile) ? Model.MetaTile : Model.NewsTitle;
                ViewBag.MetaDescription = !string.IsNullOrEmpty(Model.MetaDescription) ? Model.MetaDescription : Model.NewsTitle;
                ViewBag.MetaKeywords = !string.IsNullOrEmpty(Model.MetaKeywords) ? Model.MetaKeywords : Model.NewsTitle;
                Layout = "~/Views/Shared/_LayoutOneCss.cshtml"; }

<style>
    
    .pulse-button {
        position: relative;
        /*width: 100px;
    height: 100px;*/
        padding: 15px 30px 15px 30px !important;
        border: none;
        box-shadow: 0 0 0 0 rgba(255, 191, 9, 0.7);
        border-radius: 25px;
        font-weight: bold;
        font-size: 17px;
        background-color: #ffbf09;
        cursor: pointer;
        -webkit-animation: pulse 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
        -moz-animation: pulse 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
        -ms-animation: pulse 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
        animation: pulse 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
        color: black;
    }

    .pulse-button:hover {
        -webkit-animation: none;
        -moz-animation: none;
        -ms-animation: none;
        animation: none;
        color: #ffffff;
    }
    #news_section {
        padding-top: 10px;
        background: #e7ecea;
    }

        #news_section h3,
        .benefits-bg h3 {
            color: #084f72;
        }

        #news_section .news_bg {
            padding-top: 10px;
            background: #ffffff;
            margin-bottom: 20px;
        }

    div#news {
        border: 1px solid #ddd;
        padding: 15px;
        margin-bottom: 15px;
    }

    #news ul li {
        margin-left: 20px;
    }

    .sub_heading {
        color: #23527c;
        font-size: 17px !important;
    }

    #news_section a {
        color: #337ab7 !important;
    }

        #news_section a.hvr-wobble-vertical {
            color: #fff !important;
        }

    #news_section h1.page_title {
        font-size: 50px !important;
    }

    #news_section .newsButton img {
        display: inline !important;
        margin-right: 10px;
    }

    #news_section .imgButton {
        text-align: center;
        margin-top: 10px;
        margin-bottom: 22px;
    }

    #news_section a.newsButton {
        margin-right: 30px;
        text-decoration: none;
    }

    #news_section .btn-hot {
        color: #ffffff !important;
        background-color: #db5566;
        border-bottom: 2px solid #af4451;
    }

    #news_section .btn-buynow {
        background-color: #F50057;
        border-color: #F50057;
        color: #ffffff !important;
    }

    #news_section .btn-primary {
        color: #ffffff !important;
    }

    #news_section h3 {
        font-family: 'Open Sans', sans-serif;
        font-size: 22px !important;
    }
</style>



<section id="report-title" class="white_section section_gap">
    @{ Html.RenderPartial("_NewSearch"); }
    <div class="container">
        @{ Html.RenderPartial("_breadcrumb", (Model.IsArticle ? "<a href='/all-articles'>Article</a>|" : "<a href='/all-news'>News</a>|") + Model.NewsTitle); }
        <div class="heading">
            <div class="col-sm-12">
                <h1 class="reporttitle"> @Model.NewsTitle</h1>
            </div>
        </div>
        @*<div class="row" style="text-align:center;">
            <div class="col-md-12">
                <div class="addthis_inline_share_toolbox"></div>
            </div>
        </div>*@
    </div>
</section>

<section id="news_section">
    <div class="container">
        <div class="col-sm-12 news_bg tab">
            <p class="publishedDate"><strong style="color:#23527c;"><i class="fa fa-calendar"></i> @Model.PublishedDate.Value.ToString("dd-MMM-yyyy") | Zion Market Research</strong></p>
            <div id="news" class="tab-content" style="text-align:justify;">
                @Html.Raw(Model.Description)
            </div>

        </div>
    </div>


</section>

@if (Model.ReportId != null && Model.ReportId > 0) { Html.RenderPartial("~/Views/Report/_PopForm.cshtml", new ZionMarketResearch.Models.AvailPDF { ReportId = (int)Model.ReportId, ReportTitle = Model.ReportTitle }); }

<script>
    $(document).ready(function () {
        var reportDescImg = $("#news img");

        $(reportDescImg).addClass("img-responsive");
        $(reportDescImg).css("margin", "0 auto");
        $("#news_section a").css("word-break", "break-all");
    });
</script>

<script type="application/ld+json">
    {
    "@@context": "http://www.schema.org/",
    "@@type": "@(Model.IsArticle ? "Article" : "NewsArticle")",
    "name": "@Model.NewsTitle",
    "headline":"@Model.NewsTitle",
    "image":{"@@type": "ImageObject","url":"https://www.zionmarketresearch.com/images/zionLogo01.png", "height": "200px", "width": "200px"},
    "author":
    {
    "@@type": "Organization",
    "logo": {"@@type": "ImageObject","url":"https://www.zionmarketresearch.com/images/zionLogo01.png"},
    "name": "Zion Market Research",
    "url": "https://www.zionmarketresearch.com/@(Model.IsArticle ? Url.Action("AllNews", "News") : Url.Action("AllArticles", "Article"))"
    },
    "publisher":
    {
    "@@type": "Organization",
    "name": "Zion Market Research",
    "logo": {"@@type": "ImageObject","url":"https://www.zionmarketresearch.com/images/zionLogo01.png"}
    },
    "articleBody": "@Html.Raw(Model.Description.Substring(0, Model.Description.IndexOf("</p>")).Replace("<p>", string.Empty).Replace("</p>", string.Empty).Replace("\"", "'"))",
    "datePublished": "@Model.PublishedDate.Value.ToString("yyyyMMdd")",
    "url": "https://zionmarketresearchstore.com/@(Model.IsArticle ? "article" : "news")/@Model.NewsUrl",
    "dateModified": "@Model.PublishedDate.Value.ToString("yyyyMMdd")",
    "mainEntityOfPage":"https://www.zionmarketresearch.com/news/@Model.NewsUrl"
    }
</script>
@section metaTags{
    <!-- Go to www.addthis.com/dashboard to customize your tools -->
