@model List<ZionMarketResearch.Models.LatestNewsView>
<ul class="pricing-boxes three">
    @foreach (var news in Model)
    {
        <li>
            <div class="plan-name">
                <h3 title="@news.NewsTitle">@(news.NewsTitle.Length > 60 ? news.NewsTitle.Substring(0, 59) + "..." : news.NewsTitle)</h3>
            </div>
            <div class="plan-features">
                <p class="rpt-desc">
                    <i class="fa fa-calendar"></i> @news.PublishedDate.Value.ToString("dd-MMM-yyyy")
                </p>
                <p class="para-padding">@ZionMarketResearch.Util.Utility.StripHTML(news.Description).ZSubstring(0, 290)</p>
                <a class="btn btn-primary" href="@Url.Action("Index", "News", new { url = news.NewsUrl })">Read more</a>
            </div>
        </li>
    }
</ul>