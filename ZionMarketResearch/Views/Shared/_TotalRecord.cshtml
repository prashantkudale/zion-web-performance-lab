@model PagedList.IPagedList<object>
<div class="total-records">Total Records - @Model.TotalItemCount | Displaying - @(((Model.PageNumber - 1) * 10) + 1) To @(((Model.PageNumber - 1) * 10) + Model.Count)</div>
<style>
    .total-records {
        font-weight: bold;
        color: #23527c;
    }
</style>