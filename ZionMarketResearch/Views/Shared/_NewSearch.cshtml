
<style>
    .search {
        width: 100%;
        position: relative;
        display: flex;
        height: 55px;
    }

    .searchTerm {
        width: 100%;
        border: 1px solid #e0e0e0;
        border-right: none;
        padding: 0 20px;
        height: 55px;
        border-radius: 8px 0 0 8px;
        outline: none;
        color: #555;
        background: #fff;
        font-size: 15px;
        font-family: inherit;
    }

        .searchTerm:focus {
            color: #123456;
            font-size: 18px;
            font-family: Tahoma, sans-serif;
            border-color: #00B4CC;
        }

    .searchButton:hover {
        background: #0099b0;
    }

    .searchButton {
        width: 65px;
        height: 55px;
        border: 0;
        background: #00B4CC;
        text-align: center;
        color: #fff;
        border-radius: 0 8px 8px 0;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: background 0.2s;
    }
    /*Resize the wrap to see the search bar change!*/

    .wrap {
        width: 60% !important;
        position: relative;
        left: 50%;
        transform: translateX(-50%);
    }

    #search-section {
        margin: 10px auto 35px auto !important;
        min-height: 80px;
        position: relative;
    }

        #search-section p {
            margin: auto 0;
            width: 100%;
        }

    @@media (max-width: 768px) {
        #search-section {
            margin: 15px 0px 20px 0px;
            min-height: 100px;
        }

        .wrap {
            width: 95% !important;
        }

       /* section#report-title {
            margin-top: 50px !important;
        }*/
    }
</style>

<div id="search-section">
    <div class="wrap">
        <div class="search">
            <input value="@Request.QueryString["q"]"
                   type="text"
                   class="searchTerm autocomplete"
                   id="q"
                   placeholder="What are you looking for?"
                   onkeyup="KeyUp(event)" />
            <button id="btnSearch"
                    type="button"
                    class="searchButton"
                    aria-label="Search"
                    onclick="SimpleSearch()">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="20" height="20"
                     viewBox="0 0 512 512"
                     fill="#fff"
                     aria-hidden="true">
                    <path d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0S416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z" />
                </svg>
            </button>
        </div>
    </div>
</div>
<div style="clear:both;"></div>
