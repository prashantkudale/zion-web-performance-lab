@section FooterMSScripts {
    <script>
        jQuery(function ($) {
            $(document).ready(function () {

                // ── Testimonial fade init ──────────────────────────────────────
                $(".testimonialText li").fadeTo(0, 0);       // instant hide (no "fast" animation)
                $(".testimonialText li:first").fadeTo(0, 1); // instant show first item

                $(".imageSlide .imageBox").removeClass("activeImage");
                $(".imageSlide .imageBox:first").addClass("activeImage");

                $(".imageSlide .imageBox").mouseenter(function () {
                    if (!$(this).hasClass("activeImage")) {
                        var gi = $(this).index();

                        $(".imageSlide .imageBox").removeClass("activeImage");
                        $(this).addClass("activeImage");

                        $(".testimonialText li").fadeTo("fast", 0);
                        $(".testimonialText li:eq(" + gi + ")").fadeTo("fast", 1);
                    }
                });

                function count(options) {
                    var $this = $(this);
                    options = $.extend({}, options || {}, $this.data('countToOptions') || {});
                    $this.countTo(options);
                }

            });
        });
    </script>

    <script defer src="~/Content/js/jquery.easing.js"></script>
    <script defer src="~/Content/js/jquery.isotope.js"></script>
    <script defer src="~/Content/js/custom.js"></script>
}