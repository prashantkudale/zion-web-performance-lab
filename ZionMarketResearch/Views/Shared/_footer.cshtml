@section FooterScripts {
    <script type="text/javascript">
        jQuery(function ($) {
            $(document).ready(function () {
                //enabling stickUp on the '.navbar-wrapper' class

                // run rlightbox
                //$(".lb").rlightbox();
                //$(".lb_title-overwritten").rlightbox({ overwriteTitle: true });

                //$('.flexslider').flexslider({
