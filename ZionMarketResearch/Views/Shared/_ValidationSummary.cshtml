@model ModelStateDictionary
@if (!Model.IsValid)
{
    <div class="panel panel-danger" id="validationSummary">
        <div class="panel-heading"><strong>Please correct following errors</strong></div>
        <div class="panel-body">
            <ul>
                @foreach (var modelError in
                     Model.SelectMany(keyValuePair => keyValuePair.Value.Errors))
                {
                    <li>@modelError.ErrorMessage</li>
                }
            </ul>
        </div>
    </div>
}