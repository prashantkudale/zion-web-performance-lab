<!DOCTYPE html>
@{
    if (ViewBag.Lang == null)
    {
        ViewBag.Lang = "en";
    }
}
<html lang="@ViewBag.Lang">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title lang="@ViewBag.Lang">@ViewBag.Title</title>

    <meta id="MetaAuthor" name="AUTHOR" content="Zion Market Research" />
    <meta name="REVISIT-AFTER" content="1 DAYS" />
    <meta name="RATING" content="GENERAL" />
    <meta http-equiv="PAGE-ENTER" content="RevealTrans(duration=5,transition=12)" />

    <meta content="text/javascript" http-equiv="Content-Script-Type" />
    <meta content="text/css" http-equiv="Content-Style-Type" />
    <meta name="language" content="@ViewBag.Lang" />

    <meta id="MetaKeywords" name="keywords" content="@ViewBag.MetaKeywords" />
    <meta id="MetaDescription" name="description" content="@ViewBag.MetaDescription" />

    <meta property="og:image" content="@ViewBag.Firstimage" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:url" content="@Request.Url" />
    <meta property="og:site_name" content="Zion Market Research" />
    <meta property="og:title" content="@ViewBag.Title" />

    <meta name="twitter:image" content="@ViewBag.Firstimage" />
    <meta name="twitter:description" content="@ViewBag.MetaDescription" />
    <meta name="twitter:title" content="@ViewBag.Title" />
    <meta name="twitter:site" content="zion_research" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="Page-Topic" content="Market Research" />
    <meta name="document-type" content="Public" />
    <meta name="document-classification" content="Market Research Services" />
    <meta name="coverage" content="worldwide" />
    <meta name="distribution" content="Global" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    @RenderSection("metaTags", false)

    <link rel="canonical" href="@Request.Url.GetLeftPart(UriPartial.Path).Trim('/')" />
    <link rel="alternate" hrefLang="x-default" href="https://www.zionmarketresearch.com/report/@ViewBag.ReportUrlOrig" />
    <link rel="alternate" hrefLang="en" href="https://www.zionmarketresearch.com/report/@ViewBag.ReportUrlOrig" />
    <link rel="alternate" hrefLang="de" href="https://www.zionmarketresearch.com/de/report/@ViewBag.ReportUrlOrig" />
    <link rel="alternate" hrefLang="fr" href="https://www.zionmarketresearch.com/fr/report/@ViewBag.ReportUrlOrig" />

    @if (
        Request.Url.ToString().Contains("/buynow/") ||
        Request.Url.ToString().Contains("/prebook/") ||
        Request.Url.ToString().Contains("/toc/")
    )
    {
        <meta name="robots" content="noindex,nofollow" />
    }

    <link rel="preload"
          as="image"
          href="/images/zion-market-research-logo.png"
          fetchpriority="high" />

    <link rel="stylesheet"
          href="~/Content/css/@ViewBag.css"
          media="print"
          onload="this.media='all'" />

    <link rel="stylesheet"
          href="~/Content/css/bootstrap.custom-3.4.1.css"
          media="print"
          onload="this.media='all'" />

    <link rel="stylesheet"
          href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/faicons", true)"
          media="print"
          onload="this.media='all'" />

    <noscript>
        <link rel="stylesheet"
              href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/faicons", true)" />
    </noscript>

    <link rel="stylesheet"
          href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/autocompletecss", true)"
          media="print"
          onload="this.media='all'" />

    <noscript>
        <link rel="stylesheet"
              href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/autocompletecss", true)" />
    </noscript>

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <noscript>
        <link href="https://fonts.googleapis.com/css?family=Roboto:400,700,500,300&display=swap"
              rel="stylesheet" />
    </noscript>
</head>

<body style="background-color:#fff">

    <div class="wrapper" id="wrapper">
        @{ Html.RenderPartial("_headerMS"); }

        @RenderBody()

        @{ Html.RenderAction("FooterMS", "Home"); }
    </div>

    <script>
        window.jQueryQueue = window.jQueryQueue || [];
        window.$ = window.jQuery = function (fn) {
            if (typeof fn === 'function') {
                window.jQueryQueue.push(fn);
            }
        };

        window.afterPaint = function (fn) {
            requestAnimationFrame(function () {
                setTimeout(fn, 0);
            });
        };
    </script>

    <script defer src="~/Scripts/jquery-3.7.1.min.js"
            onload="
                window.$ = window.jQuery = jQuery;
                window.jQueryQueue.forEach(function(fn){ jQuery(document).ready(fn); });
                window.jQueryQueue = [];
            ">
    </script>

    @RenderSection("HeaderMSScripts", required: false)
    @RenderSection("FooterMSScripts", required: false)
    @RenderSection("ReportIndexScripts", required: false)
    @RenderSection("NewsIndexScript", required: false)
    @RenderSection("scripts", required: false)

    <div class="google_translate_element"></div>

    <script>
        setTimeout(function () {
            window.gtranslateSettings = {
                default_language: "en",
                url_structure: "sub_directory",
                languages: ["en", "fr", "de"],
                wrapper_selector: ".google_translate_element"
            };

            var s = document.createElement("script");
            s.src = "https://cdn.gtranslate.net/widgets/latest/float.js";
            s.async = true;
            document.body.appendChild(s);
        }, 5000);
    </script>

    <script>
        function loadGA() {
            if (window.gaLoaded) return;

            window.gaLoaded = true;

            var s = document.createElement('script');
            s.src = "https://www.googletagmanager.com/gtag/js?id=G-YZ4QTE5YV4";
            s.async = true;
            document.head.appendChild(s);

            window.dataLayer = window.dataLayer || [];

            function gtag() { dataLayer.push(arguments); }

            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', 'G-YZ4QTE5YV4');
        }

        ['scroll'].forEach(function (evt) {
            window.addEventListener(evt, loadGA, { once: true });
        });
    </script>

    <script>
        function loadTawk() {
            if (window.tawkLoaded) return;

            window.tawkLoaded = true;

            var s1 = document.createElement("script");
            s1.async = true;
            s1.src = "https://embed.tawk.to/5ff828e3a9a34e36b96a4b7a/1erglvfhg";
            s1.charset = "UTF-8";
            s1.setAttribute("crossorigin", "*");

            document.body.appendChild(s1);
        }

        ['scroll'].forEach(function (event) {
            window.addEventListener(event, loadTawk, { once: true });
        });
    </script>

    <script>
        function loadBootstrap() {
            if (window.bootstrapLoaded) return;
            window.bootstrapLoaded = true;

            var s = document.createElement("script");
            s.src = "/Scripts/bootstrap-3-3-7.min.js";
            s.async = true;

            document.body.appendChild(s);
        }

        // BEST: Load after page is idle
        if ('requestIdleCallback' in window) {
            requestIdleCallback(loadBootstrap);
        } else {
            setTimeout(loadBootstrap, 5000);
        }
    </script>

    <script>
        function loadLayoutJS() {
            var s = document.createElement("script");
            s.src = "/Scripts/layoutOne.js";
            s.async = true;
            document.body.appendChild(s);
        }

        requestIdleCallback(loadLayoutJS);
    </script>

    <script>
        function autocompleteJS() {
            var s = document.createElement("script");
            s.src = "/bundles/autocompletejs?v=kyRM0y4BK";
            s.async = true;
            document.body.appendChild(s);
        }

        requestIdleCallback(autocompleteJS);
    </script>

</body>
</html>