    @Styles.Render("~/bundles/autocompletecss")
    @Scripts.Render("~/bundles/autocompletejs")
    <script>
        function SimpleSearch() {
            window.location.href = "/simplesearch?q=" + encodeURIComponent($("#q").val());
        }

        function KeyUp(e) {
            if (e.keyCode === 13) {
                SimpleSearch();
            }
        }
    </script>

