<!DOCTYPE html>
@{ if (ViewBag.Lang == null) { ViewBag.Lang = "en"; }}
<html lang="@ViewBag.Lang">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title lang="@ViewBag.Lang">@ViewBag.Title</title>
    <meta id="MetaAuthor" name="AUTHOR" content="Zion Market Research" />
    <meta name="REVISIT-AFTER" content="1 DAYS" />
    <meta name="RATING" content="GENERAL" />
    <meta http-equiv="PAGE-ENTER" content="RevealTrans(duration=5,transition=12)" />
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta content="text/javascript" http-equiv="Content-Script-Type" />
    <meta content="text/css" http-equiv="Content-Style-Type" />
    <meta name="language" content="@ViewBag.Lang" />
    <meta id="MetaKeywords" lang="@ViewBag.Lang" name="keywords" content="@ViewBag.MetaKeywords" />
    <meta id="MetaDescription" lang="@ViewBag.Lang" name="description" content="@ViewBag.MetaDescription" />

    <!--<meta name="title" content="@ViewBag.Title" />-->
    <meta property="og:image" content="@ViewBag.Firstimage" />
    <meta property="og:type" content="website">
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:url" content="@Request.Url" />
    <meta property="og:site_name" content="Zion Market Research" />
    <meta property="og:title" content="@ViewBag.Title" />
    <meta name="twitter:image" content="@ViewBag.Firstimage" />
    <meta name="twitter:description" content="@ViewBag.MetaDescription" />
    <meta name="twitter:title" content="@ViewBag.Title" />

    <meta name="twitter:site" content="zion_research" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="Page-Topic" content="Market Research" />
    <meta name="document-type" content="Public" />
    <meta name="document-classification" content="Market Research Services" />
    <meta name="RATING" content="GENERAL" />
    <meta name="REVISIT-AFTER" content="1 DAYS" />
    <meta id="MetaAuthor" name="AUTHOR" content="Zion Market Research" />
    <meta name="coverage" content="worldwide" />
    <meta name="language" content="EN" />
    <meta name="distribution" content="Global" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @RenderSection("metaTags", false)
    <link rel="canonical" href="@Request.Url.GetLeftPart(UriPartial.Path).Trim('/')" />
    <link rel="alternate" hrefLang="x-default" href="https://www.zionmarketresearch.com/report/@ViewBag.ReportUrlOrig" />
    <link rel="alternate" hrefLang="en" href="https://www.zionmarketresearch.com/report/@ViewBag.ReportUrlOrig" />
    <link rel="alternate" hrefLang="de" href="https://www.zionmarketresearch.com/de/report/@ViewBag.ReportUrlOrig" />
    <link rel="alternate" hrefLang="fr" href="https://www.zionmarketresearch.com/fr/report/@ViewBag.ReportUrlOrig" />

    @if (Request.Url.ToString().Contains("/buynow/")
        || Request.Url.ToString().Contains("/prebook/")
        || Request.Url.ToString().Contains("/toc/")
)
    {
<meta name="robots" content="noindex,nofollow" />
}
    <!-- report style-->
    <link rel="stylesheet" href="~/Content/css/@ViewBag.css" />

    <!-- Latest compiled and minified CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" />

    <!-- jQuery library -->
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Latest compiled JavaScript -->
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/3.3.1/js/bootstrap.min.js" async></script>

    <!-- old code-->
    <!-- font icon css style-->
    @*<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.2.0/css/font-awesome.min.css" type="text/css" />*@
    @*<script src="https://kit.fontawesome.com/370a8ee1e3.js" crossorigin="anonymous"></script>*@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <link href="https://fonts.googleapis.com/css2?family=Roboto&display=swap" rel="stylesheet" as="font" />
    <!-- old code end-->


    <script>
        (function (i, s, o, g, r, a, m) {
            i['GoogleAnalyticsObject'] = r; i[r] = i[r] || function () {
                (i[r].q = i[r].q || []).push(arguments)
            }, i[r].l = 1 * new Date(); a = s.createElement(o),
                m = s.getElementsByTagName(o)[0]; a.async = 1; a.src = g; m.parentNode.insertBefore(a, m)
        })(window, document, 'script', 'https://www.google-analytics.com/analytics.js', 'ga');

        ga('create', 'UA-81189834-1', 'auto');
        ga('send', 'pageview');

    </script>


