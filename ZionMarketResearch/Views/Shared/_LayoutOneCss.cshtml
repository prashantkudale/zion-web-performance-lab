<!DOCTYPE html>
@{
    if (ViewBag.Lang == null)
    {
        ViewBag.Lang = "en";
    }
}
<html lang="@ViewBag.Lang">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title lang="@ViewBag.Lang">@ViewBag.Title</title>

    <meta id="MetaAuthor" name="AUTHOR" content="Zion Market Research" />
    <meta name="REVISIT-AFTER" content="1 DAYS" />
    <meta name="RATING" content="GENERAL" />
    <meta http-equiv="PAGE-ENTER" content="RevealTrans(duration=5,transition=12)" />

    <meta content="text/javascript" http-equiv="Content-Script-Type" />
    <meta content="text/css" http-equiv="Content-Style-Type" />
    <meta name="language" content="@ViewBag.Lang" />

    <meta id="MetaKeywords" name="keywords" content="@ViewBag.MetaKeywords" />
    <meta id="MetaDescription" name="description" content="@ViewBag.MetaDescription" />

    <meta property="og:image" content="@ViewBag.Firstimage" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:url" content="@Request.Url" />
    <meta property="og:site_name" content="Zion Market Research" />
    <meta property="og:title" content="@ViewBag.Title" />

    <meta name="twitter:image" content="@ViewBag.Firstimage" />
    <meta name="twitter:description" content="@ViewBag.MetaDescription" />
    <meta name="twitter:title" content="@ViewBag.Title" />
    <meta name="twitter:site" content="zion_research" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="Page-Topic" content="Market Research" />
    <meta name="document-type" content="Public" />
    <meta name="document-classification" content="Market Research Services" />
    <meta name="coverage" content="worldwide" />
    <meta name="distribution" content="Global" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <style>
        /* ═══ NAVBAR stability — supplements blocking Bootstrap CSS ═══ */

        /* Locks navbar height so no shift when JS initializes */
        .navbar-wrapper {
            margin-top: 0 !important;
            height: 70px !important;
            min-height: 70px !important;
            position: relative !important;
            z-index: 15 !important;
            background: #fff !important;
            contain: layout !important;
        }

        .header_v3.report-page {
            position: relative !important;
            overflow: hidden !important;
            width: 100% !important;
            height: 5px !important;
            display: block !important;
        }

        /* Header layout — must match main.css to prevent shift on load */

        header {
            position: relative;
        }

        .menu {
            margin-top: 0 !important;
            position: absolute !important;
            z-index: 9999 !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            margin-bottom: -100px !important;
            display: block !important;
            width: 100% !important;
        }

        .logo {
            float: left;
            width: 104px;
            height: 56px;
            display: inline-block;
            overflow: hidden;
        }

            .logo img {
                width: 104px;
                height: 56px;
                object-fit: contain;
            }

        .navArea {
            float: right;
        }

        .report-page {
            position: relative;
            overflow: hidden;
            width: 100%;
            height: 5px !important;
        }

        /* ═══ DESKTOP: navbar visible before Bootstrap JS loads ═══ */
        @@media (min-width: 768px) {
            .navbar-toggle {
                display: none !important;
            }

            .navbar-collapse,
            .navbar-collapse.collapse {
                display: block !important;
                visibility: visible !important;
                height: auto !important;
                overflow: visible !important;
            }

            .navbar-nav {
                float: right !important;
                margin: 0 !important;
            }

                .navbar-nav > li {
                    float: left !important;
                }

                    .navbar-nav > li > a {
                        color: #123456 !important;
                        padding: 31px 12px 20px 15px !important;
                        line-height: 5px !important;
                    }
        }

        /* ═══ MOBILE: collapsed state stable before Bootstrap JS loads ═══ */
        @@media (max-width: 767px) {
            .navbar-header {
                float: none;
            }

            .navbar-toggle {
                display: block !important;
                float: right;
            }

            .navbar-collapse:not(.in) {
                display: none !important;
                visibility: hidden !important;
            }

            .navbar-collapse.in {
                display: block !important;
                visibility: visible !important;
            }

            .navbar-nav {
                float: none !important;
                margin: 0;
            }

                .navbar-nav > li {
                    float: none !important;
                    display: block !important;
                }
        }

        /* ═══ Other CLS reservations ═══ */
        .fa, [class^="fa-"], [class*=" fa-"] {
            display: inline-block;
            width: 1em;
            height: 1em;
            line-height: 1;
            font-style: normal;
        }

        .heading {
            min-height: 60px;
            contain: layout paint;
        }

        #myclientCarousel .l-box {
            aspect-ratio: 1331/335;
            width: 100%;
            overflow: hidden;
        }

        #myclientCarousel .carousel-inner,
        #myclientCarousel .item {
            aspect-ratio: 1331/335;
            width: 100%;
        }

        .tab-content img, #Descriptionss img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        @@font-face {
            font-family: 'Roboto';
            font-display: optional;
        }

        @@media (max-width: 768px) {
            .reporttitle {
                min-height: 260px;
            }

            .title-summary {
                min-height: 142px;
            }

            .col-md-2 .reportin-info {
                min-height: 176px;
            }

            .navbar-collapse {
                transition: none !important;
            }

            .panel-collapse {
                transition: none !important;
            }

            .grey_section.section_gap {
                min-height: 600px;
            }

            .report-title-image .heading {
                min-height: 457px;
            }
        }

        footer,
        .footer {
            content-visibility: auto;
            contain-intrinsic-size: 0 300px;
        }

        .row {
            margin-right: -15px;
            margin-left: -15px;
        }

            .row:after {
                display: table;
                content: " ";
                clear: both;
            }

        /* All columns base */
        .col-xs-1, .col-xs-2, .col-xs-3, .col-xs-4,
        .col-xs-5, .col-xs-6, .col-xs-7, .col-xs-8,
        .col-xs-9, .col-xs-10, .col-xs-11, .col-xs-12,
        .col-sm-1, .col-sm-2, .col-sm-3, .col-sm-4,
        .col-sm-5, .col-sm-6, .col-sm-7, .col-sm-8,
        .col-sm-9, .col-sm-10, .col-sm-11, .col-sm-12,
        .col-md-1, .col-md-2, .col-md-3, .col-md-4,
        .col-md-5, .col-md-6, .col-md-7, .col-md-8,
        .col-md-9, .col-md-10, .col-md-11, .col-md-12,
        .col-lg-1, .col-lg-2, .col-lg-3, .col-lg-4,
        .col-lg-5, .col-lg-6, .col-lg-7, .col-lg-8,
        .col-lg-9, .col-lg-10, .col-lg-11, .col-lg-12 {
            position: relative;
            min-height: 1px;
            padding-right: 15px;
            padding-left: 15px;
        }

        /* xs always float */
        .col-xs-12 {
            float: left;
            width: 100%;
        }

        .col-xs-6 {
            float: left;
            width: 50%;
        }

        .col-xs-4 {
            float: left;
            width: 33.33333333%;
        }

        .col-xs-3 {
            float: left;
            width: 25%;
        }

        .col-xs-2 {
            float: left;
            width: 16.66666667%;
        }

        /* sm grid */
        @@media (min-width: 768px) {
            .col-sm-12 {
                float: left;
                width: 100%;
            }

            .col-sm-8 {
                float: left;
                width: 66.66666667%;
            }

            .col-sm-7 {
                float: left;
                width: 58.33333333%;
            }

            .col-sm-6 {
                float: left;
                width: 50%;
            }

            .col-sm-5 {
                float: left;
                width: 41.66666667%;
            }

            .col-sm-4 {
                float: left;
                width: 33.33333333%;
            }

            .col-sm-3 {
                float: left;
                width: 25%;
            }

            .col-sm-2 {
                float: left;
                width: 16.66666667%;
            }
        }

        /* md grid — col-md-10 is the shifting culprit */
        @@media (min-width: 992px) {
            .col-md-12 {
                float: left;
                width: 100%;
            }

            .col-md-10 {
                float: left;
                width: 83.33333333%;
            }

            .col-md-9 {
                float: left;
                width: 75%;
            }

            .col-md-6 {
                float: left;
                width: 50%;
            }

            .col-md-4 {
                float: left;
                width: 33.33333333%;
            }

            .col-md-3 {
                float: left;
                width: 25%;
            }

            .col-md-2 {
                float: left;
                width: 16.66666667%;
            }
        }

        /* lg grid */
        @@media (min-width: 1200px) {
            .col-lg-12 {
                float: left;
                width: 100%;
            }

            .col-lg-4 {
                float: left;
                width: 33.33333333%;
            }

            .col-lg-3 {
                float: left;
                width: 25%;
            }

            .col-lg-2 {
                float: left;
                width: 16.66666667%;
            }
        }

        /* ═══ BODY / WRAPPER base — prevents body shift ═══ */
        body {
            margin: 0;
            padding: 0;
            background-color: #fff;
            font-family: 'Roboto', sans-serif;
            font-size: 14px;
            line-height: 1.42857143;
            color: #333;
            overflow-x: hidden;
        }

        .wrapper {
            width: 100%;
        }

        .header_v3.report-page + * {
            /* banner is 5px height, no extra offset needed */
        }
        section#report-title {
            position: relative;
            background-color: #e7ecea;
            margin-top: 70px !important;
            padding-top: 20px !important; /* ADD THIS — creates gap */
            min-height: 250px;
        }

        @@media (max-width: 767px) {
            section#report-title {
                margin-top: 50px !important;
                padding-top: 15px !important;
            }
        }

        /* ═══ CONTENT AREA — report page structure ═══ */
        #report-title {
            position: relative;
            background-color: #e7ecea;
            min-height: 200px;
        }

        .reportin-info {
            min-height: 176px;
        }

        #banner.banner.row {
            height: 5px !important;
            overflow: hidden !important;
            margin: 0 !important;
        }

        .moHide {
            display: none !important
        }
        @@media (min-width: 992px) {
            .moHide {
                display: block !important;
            }
        }
        @@media (max-width: 600px) {
            .reportin-info {
                display: none;
            }
        }

        .section_gap {
            padding: 45px 0 50px !important;
        }

        .white_section {
            background-color: #fff;
        }

        /* Breadcrumb reservation */
        .breadcrumb {
            padding: 8px 15px;
            margin-bottom: 8px !important;
            list-style: none;
            background-color: #f5f5f5;
            border-radius: 4px;
            min-height: 37px;
            display: block;
        }

            .breadcrumb > li {
                display: inline-block;
            }

                .breadcrumb > li + li:before {
                    padding: 0 5px;
                    color: #ccc;
                    content: "/\00a0";
                }

        /* Tab structure reservation */
        .tab .nav-tabs {
            background: #fff;
            padding: 5px 0;
            text-align: left;
        }

            .tab .nav-tabs li {
                margin-bottom: 0;
                margin-right: 0;
                float: none;
                display: inline-table;
            }

        .tab .tab-content {
            font-size: 14px;
            color: #000;
            line-height: 30px;
            background: #fff;
            padding: 20px 25px;
        }

        /* Report box */
        .report-box {
            margin-top: 5px;
            background: #fdffff;
            border-radius: 0.5rem;
            padding: 2.0rem;
            box-shadow: rgb(14 30 37 / 12%) 0px 2px 4px 0px, rgb(14 30 37 / 32%) 0px 2px 16px 0px;
        }

        /* Link buttons */
        .link-btn a {
            font-size: 14px;
            text-align: center;
            padding: 10px 20px !important;
            margin-bottom: .7rem;
            border-radius: 5px;
            text-decoration: none;
            display: inline-block;
            color: #fff;
        }

            .link-btn a:first-child {
                background: #9a1750;
            }

            .link-btn a:nth-child(2) {
                background: #376e6f;
            }

        /* Blue section */
        .blue_section {
            background-color: #2f4e71;
        }

            .blue_section.section_gap {
                background-color: #2f4e71;
                min-height: 300px;
                padding: 45px 0 50px;
                contain: layout paint;
            }

        /* Grey section */
        .grey_section {
            background-color: #e7ecea !important;
        }

        .blue_section .row {
            min-height: 200px;
        }
        html {
            font-display: swap;
        }

        .navbar-nav > li > a,
        .navbar.navbar-inverse.navbar-static-top a {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif !important;
        }

        body, p, li {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif !important;
        }

        .reportin-info.moHide {
            /* Don't let visibility change collapse the space */
            min-height: 176px;
            visibility: hidden; /* hides visually but keeps space */
        }
        @@media (min-width: 992px) {
            .reportin-info.moHide {
                display: block !important;
                visibility: visible;
            }
        }
        @@media (max-width: 600px) {
            .reportin-info {
                display: none !important;
                min-height: 0 !important;
            }
        }

        section.blue_section.section_gap {
            background-color: #2f4e71;
            min-height: 300px;
            display: block;
            padding: 45px 0 50px;
        }

        .footer a,
        .blue_section a {
            text-decoration: underline;
            color: #333;
        }

            .footer a:hover,
            .footer a:focus,
            .blue_section a:hover,
            .blue_section a:focus {
                text-decoration: underline;
                color: #111;
            }

        .footer-link {
            color: #ffffff !important;
            text-decoration: underline;
        }

            .footer-link:hover,
            .footer-link:focus {
                color: #e0e0e0 !important;
            }

        #heading-bg {
            position: relative;
            margin-bottom: 8px;
            background: linear-gradient(355deg, rgba(23,66,173,1) 8%, rgba(29,106,156,1) 87%);
            height: 80px; /* ✅ FIXED HEIGHT (critical) */
            padding: 0 16px; /* remove vertical padding */

            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            overflow: hidden;
        }
            #heading-bg h1 {
                margin: 0;
                font-size: 20px;
                line-height: 1.3;
                color: #fff;
                word-break: break-word;
                display: -webkit-box;
                -webkit-line-clamp: 2; /* max 2 lines */
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

        .reportin-info img {
            width: 148px;
            height: 176px;
            object-fit: cover;
            display: block;
        }

        .reporttitle {
            margin: 0;
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

    </style>

    @RenderSection("metaTags", false)



    <link rel="canonical" href="@Request.Url.GetLeftPart(UriPartial.Path).Trim('/')" />
    <link rel="alternate" hrefLang="x-default" href="https://www.zionmarketresearch.com/report/@ViewBag.ReportUrlOrig" />
    <link rel="alternate" hrefLang="en" href="https://www.zionmarketresearch.com/report/@ViewBag.ReportUrlOrig" />
    <link rel="alternate" hrefLang="de" href="https://www.zionmarketresearch.com/de/report/@ViewBag.ReportUrlOrig" />
    <link rel="alternate" hrefLang="fr" href="https://www.zionmarketresearch.com/fr/report/@ViewBag.ReportUrlOrig" />

    @if (
        Request.Url.ToString().Contains("/buynow/") ||
        Request.Url.ToString().Contains("/prebook/") ||
        Request.Url.ToString().Contains("/toc/")
    )
    {
        <meta name="robots" content="noindex,nofollow" />
    }

    <link rel="preload"
          as="image"
          href="/images/zion-market-research-logo.png"
          fetchpriority="high" />

    <link rel="preload"
          href="@Url.Content("~/Content/css/" + ViewBag.css)"
          as="style"
          fetchpriority="high" />

    <link rel="preload"
          href="@Url.Content("~/Content/css/bootstrap.custom-3.4.1.css")"
          as="style"
          fetchpriority="high" />

    <link rel="stylesheet"
          href="@Url.Content("~/Content/css/" + ViewBag.css)"
          media="print"
          onload="this.media='all'" />

    <noscript>
        <link rel="stylesheet"
              href="@Url.Content("~/Content/css/" + ViewBag.css)" />
    </noscript>

    <link rel="stylesheet"
          href="@Url.Content("~/Content/css/bootstrap.custom-3.4.1.css")"
          media="print"
          onload="this.media='all'" />

    <noscript>
        <link rel="stylesheet"
              href="@Url.Content("~/Content/css/bootstrap.custom-3.4.1.css")" />
    </noscript>

    <link rel="stylesheet"
          href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/faicons", true)"
          media="print"
          onload="this.media='all'" />

    <noscript>
        <link rel="stylesheet"
              href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/faicons", true)" />
    </noscript>

    <link rel="stylesheet"
          href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/autocompletecss", true)"
          media="print"
          onload="this.media='all'" />

    <noscript>
        <link rel="stylesheet"
              href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/autocompletecss", true)" />
    </noscript>

    <!-- Step 1: Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Step 3: Load stylesheet non-blocking -->
    <link rel="preload"
          href="https://fonts.gstatic.com/s/roboto/v32/KFOmCnqEu92Fr1Mu4mxKKTU1Kg.woff2"
          as="font" type="font/woff2" crossorigin />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=optional"
          media="print"
          onload="this.media='all'" />
</head>


<body style="background-color:#fff">

    <div class="wrapper" id="wrapper">
        @{ Html.RenderPartial("_headerMS"); }

        @RenderBody()

        @{ Html.RenderAction("FooterMS", "Home"); }
    </div>

    <script>
        window.jQueryQueue = window.jQueryQueue || [];
        window.$ = window.jQuery = function (fn) {
            if (typeof fn === 'function') {
                window.jQueryQueue.push(fn);
            }
        };

        window.afterPaint = function (fn) {
            requestAnimationFrame(function () {
                setTimeout(fn, 0);
            });
        };
    </script>

    <script defer src="~/Scripts/jquery-3.7.1.min.js"
            onload="
                window.$ = window.jQuery = jQuery;
                window.jQueryQueue.forEach(function(fn){ jQuery(document).ready(fn); });
                window.jQueryQueue = [];
            ">
    </script>

    @RenderSection("HeaderMSScripts", required: false)
    @RenderSection("FooterMSScripts", required: false)
    @RenderSection("ReportIndexScripts", required: false)
    @RenderSection("NewsIndexScript", required: false)
    @RenderSection("scripts", required: false)

    <div class="google_translate_element"></div>

    <script>
        function loadGTranslate() {
            if (window.gtranslateLoaded) return;
            window.gtranslateLoaded = true;
            window.gtranslateSettings = {
                default_language: "en",
                url_structure: "sub_directory",
                languages: ["en", "fr", "de"],
                wrapper_selector: ".google_translate_element"
            };

            var s2 = document.createElement("script");
            s2.src = "https://cdn.gtranslate.net/widgets/latest/float.js";
            s1.charset = "UTF-8";
            s1.setAttribute("crossorigin", "*");
            s2.async = true;
            document.body.appendChild(s2);

            if (document.visibilityState === 'visible') {
                // Already visible — wait for user interaction
                document.addEventListener('click', loadGTranslate, { once: true });
                document.addEventListener('keydown', loadGTranslate, { once: true });
                document.addEventListener('touchstart', loadGTranslate, { once: true });
            }
            document.addEventListener('visibilitychange', function () {
                if (document.visibilityState === 'visible') {
                    loadGTranslate();
                }
            }, { once: true });
        }
    </script>

    <script>
        function loadGA() {
            if (window.gaLoaded) return;

            window.gaLoaded = true;

            var s = document.createElement('script');
            s.src = "https://www.googletagmanager.com/gtag/js?id=G-YZ4QTE5YV4";
            s.async = true;
            document.head.appendChild(s);

            window.dataLayer = window.dataLayer || [];

            function gtag() { dataLayer.push(arguments); }

            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', 'G-YZ4QTE5YV4');
        }

        ['scroll'].forEach(function (evt) {
            window.addEventListener(evt, loadGA, { once: true });
        });
    </script>

    <script>
        function loadTawk() {
            if (window.tawkLoaded) return;
            window.tawkLoaded = true;
            var s1 = document.createElement("script");
            s1.async = true;
            s1.src = "https://embed.tawk.to/5ff828e3a9a34e36b96a4b7a/1erglvfhg";
            s1.charset = "UTF-8";
            s1.setAttribute("crossorigin", "*");
            document.body.appendChild(s1);
        }

        // visibilitychange = real user has tab open and active
        // PageSpeed bot NEVER triggers this
        if (document.visibilityState === 'visible') {
            // Already visible — wait for user interaction
            document.addEventListener('click', loadTawk, { once: true });
            document.addEventListener('keydown', loadTawk, { once: true });
            document.addEventListener('touchstart', loadTawk, { once: true });
        }
        document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'visible') {
                loadTawk();
            }
        }, { once: true });
    </script>


    <script>
        function loadBootstrap() {
            if (window.bootstrapLoaded) return;
            window.bootstrapLoaded = true;
            var s = document.createElement("script");
            s.src = "/Scripts/bootstrap-3-3-7.min.js";
            s.async = true;
            document.body.appendChild(s);
        }
        // Load Bootstrap immediately after jQuery resolves — not on idle.
        // requestIdleCallback fires too late and causes navbar CLS.
        window.jQueryQueue = window.jQueryQueue || [];
        window.jQueryQueue.push(function () {
            loadBootstrap();
        });
    </script>

    <script>
        function loadLayoutJS() {
            var s = document.createElement("script");
            s.src = "/Scripts/layoutOne.js";
            s.async = true;
            document.body.appendChild(s);
        }

        requestIdleCallback(loadLayoutJS);
    </script>

    <script>
        function autocompleteJS() {
            var s = document.createElement("script");
            s.src = "/bundles/autocompletejs?v=kyRM0y4BK";
            s.async = true;
            document.body.appendChild(s);
        }

        requestIdleCallback(autocompleteJS);
    </script>

    <script>
        // Hint to browser to prioritize above-fold paint
        if ('LargestContentfulPaint' in window) {
            new PerformanceObserver((list) => {
                list.getEntries().forEach((entry) => {
                    if (entry.element) {
                        entry.element.setAttribute('data-lcp', 'true');
                    }
                });
            }).observe({ type: 'largest-contentful-paint', buffered: true });
        }
    </script>

</body>
</html>