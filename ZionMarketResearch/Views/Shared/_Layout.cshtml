<!DOCTYPE html>
@{
    if (ViewBag.Lang == null)
    {
        ViewBag.Lang = "en";
    }
}

<html lang="@ViewBag.Lang">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- LCP image preload — FIRST in <head> so browser fetches it before anything else -->
    @RenderSection("HeadPreloads", required: false)

    <title lang="@ViewBag.Lang">@ViewBag.Title</title>

    <!-- SEO -->
    <meta id="MetaAuthor" name="AUTHOR" content="Zion Market Research" />
    <meta name="REVISIT-AFTER" content="1 DAYS" />
    <meta name="RATING" content="GENERAL" />
    <meta http-equiv="PAGE-ENTER" content="RevealTrans(duration=5,transition=12)" />
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta content="text/javascript" http-equiv="Content-Script-Type" />
    <meta content="text/css" http-equiv="Content-Style-Type" />
    <meta name="language" content="@ViewBag.Lang" />
    <meta id="MetaKeywords" lang="@ViewBag.Lang" name="keywords" content="@ViewBag.MetaKeywords" />
    <meta id="MetaDescription" lang="@ViewBag.Lang" name="description" content="@ViewBag.MetaDescription" />

    <link rel="canonical" href="@String.Concat("https://www.zionmarketresearch.com", Request.RawUrl)" />
    <link rel="alternate" href="@String.Concat("https://www.zionmarketresearch.com", Request.RawUrl)" hreflang="@ViewBag.Lang" />

    <link rel="preload"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/webfonts/fa-solid-900.woff2"
          as="font"
          type="font/woff2"
          crossorigin>

    <link rel="preload"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/webfonts/fa-brands-400.woff2"
          as="font"
          type="font/woff2"
          crossorigin>

    <!-- Favicon -->
    <link rel="shortcut icon" href="~/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="~/favicon.ico" type="image/ico" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @*<link href="https://fonts.googleapis.com/css?family=Roboto:400,700,500,300&display=swap" rel="stylesheet" media="print" onload="this.media='all'">*@
    <link href="https://fonts.googleapis.com/css?family=Roboto:400,700,500,300&display=optional" rel="stylesheet" media="print" onload="this.media='all'">
    @*<noscript>
            <link href="https://fonts.googleapis.com/css?family=Roboto:400,700,500,300&display=swap" rel="stylesheet">
        </noscript>*@
    <noscript>
        <link href="https://fonts.googleapis.com/css?family=Roboto:400,700,500,300&display=optional" rel="stylesheet">
    </noscript>

    <!-- Bootstrap CSS — render-blocking, needed for above-fold layout -->
    @*<link rel="preload" href="~/Content/css/bootstrap.custom.min.css" as="style">
        <link rel="stylesheet" href="/Content/css/bootstrap.custom.min.css">*@

    <link rel="stylesheet"
          href="/Content/css/bootstrap.custom.min.css"
          media="print"
          onload="this.media='all'">

    @*<link rel="preload"
        href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/abovefoldcss", true)"
        as="style">*@

    @*<link rel="stylesheet"
        href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/abovefoldcss", true)">*@

    <link rel="preload"
          href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/abovefoldcss", true)"
          as="style">
    <link rel="stylesheet"
          href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/abovefoldcss", true)">

    <!-- Font Awesome — separate, deferred, no minification -->
    <link rel="stylesheet"
          href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/faicons", true)"
          media="print"
          onload="this.media='all'">
    <noscript>
        <link rel="stylesheet"
              href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/faicons", true)">
    </noscript>

    <!-- Deferred non-critical CSS — loads without blocking render -->
    <link rel="stylesheet"
          href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/belowfoldcss", true)"
          media="print"
          onload="this.media='all'">
    <noscript>
        <link rel="stylesheet"
              href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/belowfoldcss", true)">
    </noscript>

    <!-- Page-specific head scripts -->
    @RenderSection("HeadScript", required: false)


<style>
        #lcp-paint-shield {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            display: block;
        }

        .superslides-loaded #lcp-paint-shield {
            display: none;
        }

        img[src*="gtranslate.net"],
        img[src*="/flags/svg/"],
        img[src*="/flags/png/"] {
            width: 20px !important;
            height: 15px !important;
            min-width: 20px !important;
            min-height: 15px !important;
            display: inline-block !important;
            aspect-ratio: 4 / 3 !important;
            vertical-align: middle !important;
        }
        /* Navbar — reserve space before any CSS file loads */
        .navbar-wrapper {
            height: 70px;
            min-height: 70px;
            background: #123456;
            position: relative;
            z-index: 15;
        }
        /* Logo — reserve exact dimensions */
        .logo img, img.zion-logo, img.saturate1 {
            width: 104px;
            height: 56px;
            display: block;
        }
        /* Banner — lock height before superslides runs */
        #banner {
            height: 100vh;
            min-height: 100vh;
            overflow: hidden;
            position: relative;
            width: 100%;
        }

        .searchButton {
            display: inline-block;
            position: relative;
        }

        .menu {
            position: absolute;
            z-index: 9999;
            left: 0;
            right: 0;
            margin-top: 0;
        }
    @@font-face {
        font-family: 'Roboto';
        font-style: normal;
        font-weight: 400;
        font-display: optional;
        src: local('Roboto'), local('Roboto-Regular');
    }

    @@font-face {
        font-family: 'Roboto';
        font-style: normal;
        font-weight: 700;
        font-display: optional;
        src: local('Roboto Bold'), local('Roboto-Bold');
    }

    @@font-face {
        font-family: 'Montserrat';
        font-style: normal;
        font-weight: 400;
        font-display: optional;
        src: local('Montserrat'), local('Montserrat-Regular');
    }

    @@font-face {
        font-family: 'Open Sans';
        font-style: normal;
        font-weight: 400;
        font-display: optional;
        src: local('Open Sans'), local('OpenSans');
    }

    .slides-container {
        display: block;
        margin: 0px !important;
        padding: 0px !important;
        list-style: none !important;
        position: relative;
        height: 100%;
        width: 100%;
    }
  /*  body {
        color: #767676 !important;
    }

    .heading p {
        color: #767676 !important;
    }*/
</style>

</head>

<body>

    <div class="wrapper" id="wrapper">
        <!-- MAIN CONTENT -->
        @RenderBody()
        <!-- FOOTER -->
        @{ Html.RenderAction("Footer", "Home"); }
    </div>


    <!-- jQuery — defer is fine, superslides guard checks $.fn.superslides -->
    @*<script defer src="https://code.jquery.com/jquery-1.11.2.min.js"></script>*@
    @*<script defer src="https://code.jquery.com/jquery-3.7.1.min.js"
        integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
        crossorigin="anonymous"></script>*@
    <script defer src="~/Scripts/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap JS -->
    @*<script defer src="https://stackpath.bootstrapcdn.com/bootstrap/3.3.1/js/bootstrap.min.js"></script>*@
    @*<script defer src="https://cdn.jsdelivr.net/npm/bootstrap@3.3.7/dist/js/bootstrap.min.js"></script>*@
    @*<script defer src="~/Content/js/jquery.superslides.js" type="text/javascript" charset="utf-8"></script>*@

    <script defer src="~/Scripts/bootstrap-3-3-7.min.js"></script>

    <!-- SCRIPTS: Dependency Order -->
    @RenderSection("MenuScripts", required: false)    <!-- Nav menu scripts -->
    @RenderSection("FooterScripts", required: false)  <!-- Footer scripts -->
    @RenderSection("IndexScripts", required: false)   <!-- Index scripts -->

    <script defer src="~/Scripts/layout.js"></script>   <!-- Layout scripts -->

    <script defer src="/bundles/autocompletejs?v=kyRM0y4BK"></script>

    <!-- Page-specific scripts -->
    @RenderSection("scripts", required: false)

    <!-- Google Analytics -->

    <script>
        function loadGA() {
            if (window.gaLoaded) return;
            window.gaLoaded = true;
            var s = document.createElement('script');
            s.src = "https://www.googletagmanager.com/gtag/js?id=G-YZ4QTE5YV4";
            s.async = true;
            document.head.appendChild(s);
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', 'G-YZ4QTE5YV4');
        }

        ['scroll', 'mousemove', 'touchstart', 'click'].forEach(function (evt) {
            window.addEventListener(evt, loadGA, { once: true });
        });

        // Idle fallback — fires after page is fully settled
        if ('requestIdleCallback' in window) {
            requestIdleCallback(loadGA, { timeout: 10000 });
        } else {
            setTimeout(loadGA, 10000); // Safari fallback
        }
    </script>

    <!-- GTranslate -->

    <div class="gtranslate_wrapper"></div>

    <script>
        setTimeout(function () {
            window.gtranslateSettings = {
                default_language: "en",
                url_structure: "sub_directory",
                languages: ["en", "fr", "de"],
                wrapper_selector: ".gtranslate_wrapper"
            };
            var s = document.createElement("script");
            s.src = "https://cdn.gtranslate.net/widgets/latest/float.js";
            s.async = true;
            document.body.appendChild(s);
        }, 5000);
    </script>

    @*<script>
            setTimeout(function () {
                var s = document.createElement("script");
                s.src = "https://cdn.gtranslate.net/widgets/latest/float.js";
                s.async = true;
                document.body.appendChild(s);
            }, 5000);
        </script>

        <script>
            window.gtranslateSettings = {
                default_language: "en",
