<!DOCTYPE html>
@{
    if (ViewBag.Lang == null)
    {
        ViewBag.Lang = "en";
    }
}

<html lang="@ViewBag.Lang">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title lang="@ViewBag.Lang">@ViewBag.Title</title>

    <!-- SEO -->
    <meta id="MetaAuthor" name="AUTHOR" content="Zion Market Research" />
    <meta name="REVISIT-AFTER" content="1 DAYS" />
    <meta name="RATING" content="GENERAL" />
    <meta http-equiv="PAGE-ENTER" content="RevealTrans(duration=5,transition=12)" />
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta content="text/javascript" http-equiv="Content-Script-Type" />
    <meta content="text/css" http-equiv="Content-Style-Type" />
    <meta name="language" content="@ViewBag.Lang" />
    <meta id="MetaKeywords" lang="@ViewBag.Lang" name="keywords" content="@ViewBag.MetaKeywords" />
    <meta id="MetaDescription" lang="@ViewBag.Lang" name="description" content="@ViewBag.MetaDescription" />

    <link rel="canonical" href="@String.Concat("https://www.zionmarketresearch.com", Request.RawUrl)" />
    <link rel="alternate" href="@String.Concat("https://www.zionmarketresearch.com", Request.RawUrl)" hreflang="@ViewBag.Lang" />

    <link rel="preload"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/webfonts/fa-solid-900.woff2"
          as="font"
          type="font/woff2"
          crossorigin>

    <link rel="preload"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/webfonts/fa-brands-400.woff2"
          as="font"
          type="font/woff2"
          crossorigin>

    <!-- Favicon -->
    <link rel="shortcut icon" href="~/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="~/favicon.ico" type="image/ico" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css?family=Roboto:400,700,500,300&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
        <link href="https://fonts.googleapis.com/css?family=Roboto:400,700,500,300&display=swap" rel="stylesheet">
    </noscript>

    <!-- Bootstrap CSS via CDN with preload and local fallback -->
    <link rel="preload" href="~/Content/css/bootstrap.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="~/Content/css/bootstrap.min.css"></noscript>

    <!-- Font Awesome Async -->
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" as="style" onload="this.rel='stylesheet'">
    <noscript>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    </noscript>

    <!-- Autocomplete -->

    <link rel="preload" href="/bundles/autocompletecss?v=r7_rJNjyW" as="style"
          onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
        <link rel="stylesheet" href="/bundles/autocompletecss?v=r7_rJNjyW">
    </noscript>

    <link rel="preload" as="image" href="/images/image01.webp" fetchpriority="high">
    <link rel="preload" as="image" href="/images/image02.webp" fetchpriority="high">

    <!-- CSS  -->

    <link rel="preload" href="/Content/css/main.min.css" as="style" onload="this.rel='stylesheet'">
    <link rel="preload" href="/Content/css/custom.min.css" as="style" onload="this.rel='stylesheet'">
    <link rel="preload" href="/Content/css/footer_css.css" as="style" onload="this.rel='stylesheet'">
    <link rel="preload" href="/Content/css/mediaquery.css" as="style" onload="this.rel='stylesheet'">
    <link rel="preload" href="/Content/css/jquery-ui-1.8.16.custom.css" as="style" onload="this.rel='stylesheet'">

    <noscript>
        <link rel="stylesheet" href="/Content/css/main.min.css">
        <link rel="stylesheet" href="/Content/css/custom.min.css">
        <link rel="stylesheet" href="/Content/css/footer_css.css">
        <link rel="stylesheet" href="/Content/css/mediaquery.css">
        <link rel="stylesheet" href="/Content/css/jquery-ui-1.8.16.custom.css">
    </noscript>

    <!-- Page-specific head scripts -->
    @RenderSection("HeadScript", required: false)

</head>

<body>

    <div class="wrapper" id="wrapper">
        <!-- MAIN CONTENT -->
        @RenderBody()
        <!-- FOOTER -->
        @{ Html.RenderAction("Footer", "Home"); }
    </div>


    <!-- jQuery CDN  -->

    <script defer src="https://code.jquery.com/jquery-1.11.2.min.js"></script>


    <!-- Bootstrap JS CDN with local fallback -->

    <script defer src="https://stackpath.bootstrapcdn.com/bootstrap/3.3.1/js/bootstrap.min.js"></script>

    <!-- SCRIPTS: Dependency Order -->
    @RenderSection("MenuScripts", required: false)    <!-- Nav menu scripts -->
    @RenderSection("FooterScripts", required: false)  <!-- Footer scripts -->
    @RenderSection("IndexScripts", required: false)   <!-- Index scripts -->

    <script defer src="~/Scripts/layout.js"></script>   <!-- Layout scripts -->

    <script defer src="/bundles/autocompletejs?v=kyRM0y4BK"></script>

    <!-- Page-specific scripts -->
    @RenderSection("scripts", required: false)

    <!-- Google Analytics -->

    <script>
            function loadGA(){
                if(window.gaLoaded) return;
                window.gaLoaded = true;

                var s = document.createElement('script');
                s.src = "https://www.googletagmanager.com/gtag/js?id=G-YZ4QTE5YV4";
                s.async = true;
                document.head.appendChild(s);

                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                window.gtag = gtag;

                gtag('js', new Date());
                gtag('config', 'G-YZ4QTE5YV4');
            }

            setTimeout(loadGA, 4000);
    </script>

    <!-- GTranslate -->

    <div class="gtranslate_wrapper"></div>

    <script>
        setTimeout(function(){
           var s=document.createElement("script");
           s.src="https://cdn.gtranslate.net/widgets/latest/float.js";
           s.async=true;
           document.body.appendChild(s);
        },5000);
    </script>

    <script>
        window.gtranslateSettings = {
        default_language: "en",
        url_structure: "sub_directory",
        languages: ["en","fr","de"],
        wrapper_selector: ".gtranslate_wrapper"
    };
    </script>

    <!-- Universal Analytics (UA) -->
    @*<script async>
            (function(i,s,o,g,r,a,m){
                    i['GoogleAnalyticsObject']=r; i[r]=i[r]||function(){
                        (i[r].q=i[r].q||[]).push(arguments)
                    }, i[r].l=1*new Date(); a=s.createElement(o),
                    m=s.getElementsByTagName(o)[0]; a.async=1; a.src=g; m.parentNode.insertBefore(a,m)
                })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');
                ga('create', 'UA-81189834-1', 'auto');
                ga('send', 'pageview');
        </script>*@

    <!-- Tawk.to live chat (async, appended to body) -->

    <script>
        function loadTawk() {
            if (window.tawkLoaded) return;
            window.tawkLoaded = true;

            var s1 = document.createElement("script");
            s1.async = true;
            s1.src = "https://embed.tawk.to/5ff828e3a9a34e36b96a4b7a/1erglvfhg";
            s1.charset = "UTF-8";
            s1.setAttribute("crossorigin", "*");

            document.body.appendChild(s1);
        }

        // Load after user interaction
        ['scroll','mousemove','touchstart','click'].forEach(function(event){
            window.addEventListener(event, loadTawk, {once:true});
        });

        // Backup: load after 8 seconds
        setTimeout(loadTawk, 8000);
    </script>

</body>

</html>