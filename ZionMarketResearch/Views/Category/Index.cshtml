        /* Full height */
        height: 100%;
        /* Center and scale the image nicely */
        background-position: center;
        background-repeat: no-repeat;
        /*background-size: cover;*/
        background-size: 100%;
    }
    /* Position text in the middle of the page/image */

    .bg-text {
        color: #123456;
        font-weight: bold;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 2;
        width: 95%;
        padding: 25px;
        /*text-align: center;*/
    }

        .bg-text a {
            color: #000000 !important;
            text-decoration: underline;
        }

        .bg-text h3,
        .bg-text p {
            margin: 0px !important;
            padding: 0px !important;
        }

    .category_box {
        /*1373*/
        max-width: 97% !important;
    }

    .bg-text h3 {
        font-size: 20px;
    }

    .category_box span img {
        opacity: 0.5;
    }

    .minimise {
        height: 174px;
        overflow: hidden;
    }

    @@media only screen and (max-width: 768px) {
        .minimise {
            height: 344px;
        }
    }

    .maximise {
        height: auto;
    }
</style>
<script>
    function scrollToHash(e, hash) {
        e.preventDefault();
        if ($(hash).length) {
            $('html, body').animate({
                scrollTop: $(hash).offset().top
            }, 900, 'swing');
        }
    }

    var isMaximise = false;

    function readMore(ctl) {
        $("section.minimise").toggleClass('maximise', 900, 'slide');
        isMaximise = !isMaximise;
        $(ctl).remove();
    }
</script>