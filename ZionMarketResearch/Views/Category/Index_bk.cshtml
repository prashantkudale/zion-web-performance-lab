<style>
    .bg-image {
        background-image: url('images/category/Consumer-Goods_lg.jpg');
        * Add the blur effect */ filter: blur(1px);
        -webkit-filter: blur(1px);
        opacity: 0.5;
        /* Full height */
        height: 100%;
        /* Center and scale the image nicely */
        background-position: center;
        background-repeat: no-repeat;
        /*background-size: cover;*/
        background-size: 100%;
    }

    .bg-image2 {
        background-image: url('images/category/Healthcare_lg.jpg');
