								}
								@if (Model.OrderSummary[0].CorporateUser != null && Model.OrderSummary[0].CorporateUser > 0)
								{
									<option value="cu" @(Model.OrderSummary[0].SelectedReportType == 2 ? "selected" : string.Empty)>Corporate User | $@Model.OrderSummary[0].CorporateUser USD</option>
								}
							</select>
						</form>
					</div>
				</div>
