@model ZionMarketResearch.Models.BuynowRepository
@{
	ViewBag.Title = (Model.OrderSummary[0].IsUpcoming ? "Prebook - " : "Buy Now - ") + Model.OrderSummary[0].ReportTitle.Substring(0, Model.OrderSummary[0].ReportTitle.ToLower().IndexOf("market") + 6);
	Layout = "~/Views/Shared/_Layout.cshtml";
}
@{ Html.RenderPartial("_breadcrumb", "<a href='/report/" + Model.OrderSummary[0].ReportUrl + "' title='" + Model.OrderSummary[0].ReportTitle + "'>Back to Report: " + Model.OrderSummary[0].ReportTitle.Substring(0, Model.OrderSummary[0].ReportTitle.ToLower().IndexOf("market") + 6) + " </a>|Buy Now"); }
<div class="row form-with-padding">
	<div class="col-sm-8">
		<h1 class="reporttitle">@Model.OrderSummary[0].ReportTitle</h1>
		<div class="row">
			<div class="alert alert-info">
				<i class="fa fa-info-circle"></i> Your personal details safe with us. <a href="/privacy-policy" target="_blank" style="text-decoration:underline;" rel="nofollow">Privacy Policy</a>
				<a href="https://seal.godaddy.com/verifySeal?sealID=eABH91l0h9MuYRpGoWkiG6NRu7Y2vaTxM5bjm0tMzUTDOhMYnSysInFUHWa0" target="_blank" rel="nofollow">
					<img style="cursor:pointer;cursor:pointer;" src="https://seal.godaddy.com/images/3/en/siteseal_gd_3_h_l_m.gif" alt="SSL site seal - click to verify" />
				</a>
				<br />
				<b>Please fill your details below, to @(Model.OrderSummary[0].IsUpcoming ? "prebook" : "purchase") this report:</b>
			</div>
			@{ Html.RenderPartial("_ValidationSummary", ViewData.ModelState); }
			<form class="form-horizontal" id="bform" action="/buynow/@(Model.OrderSummary[0].IsUpcoming ? "prebook" : "index" )" method="post">
				@Html.HiddenFor(f => f.r, new { value = ZionMarketResearch.Util.Utility.Encryptstring(Model.OrderSummary[0].ReportUrl) })
				@Html.HiddenFor(f => f.l, new { value = ZionMarketResearch.Util.Utility.Encryptstring(Model.OrderSummary[0].SelectedReportType.ToString()) })
				<div class="panel panel-primary">
					<div class="panel-heading text-center lead">@(Model.OrderSummary[0].IsUpcoming ? "Prebook this report now" : "Purchase this report now")</div>
					<div class="panel-body">
						<fieldset>
							<legend>Personal Details:</legend>
							<div id="personal">
								<div class="row">
									<div class="col-xs-6">
										<div class="form-group">
											<label for="Name" class="control-label col-xs-2">Name</label>
											<div class="col-xs-10">
												<div class="input-group">
													<span class="input-group-addon"><i class="fa fa-user"></i></span>
													@Html.TextBoxFor(f => f.Name, new { Class = "form-control", placeholder = "Enter Name Ex. - John Carter" })
												</div>
												@Html.ValidationMessageFor(f => f.Name)
											</div>
										</div>
									</div>
									<div class="col-xs-6">
										<div class="form-group">
											<label for="Email" class="control-label col-xs-2">Email</label>
											<div class="col-xs-10">
												<div class="input-group">
													<span class="input-group-addon"><i class="fa fa-envelope"></i></span>
													@Html.TextBoxFor(f => f.Email, new { Class = "form-control", placeholder = "Enter Email Id Ex. - john@microsoft.com" })
												</div>
												@Html.ValidationMessageFor(f => f.Email)
											</div>
										</div>
									</div>
								</div>
								<div class="row">
									<div class="col-xs-6">
										<div class="form-group">
											<label for="ContactNumber" class="control-label col-xs-2">Phone#</label>
											<div class="col-xs-10">
												<div class="input-group">
													<span class="input-group-addon"><i class="fa fa-phone"></i></span>
													@Html.TextBoxFor(f => f.ContactNumber, new { Class = "form-control", placeholder = "Enter Phone #" })
												</div>
												@Html.ValidationMessageFor(f => f.ContactNumber)
											</div>
										</div>
									</div>
									<div class="col-xs-6">
										<div class="form-group">
											<label for="Company" class="control-label col-xs-2">Company</label>
											<div class="col-xs-10">
												<div class="input-group">
													<span class="input-group-addon"><i class="fa fa-users"></i></span>
													@Html.TextBoxFor(f => f.Company, new { Class = "form-control", placeholder = "Enter your Company Name" })
												</div>
												@Html.ValidationMessageFor(f => f.Company)
											</div>
										</div>
									</div>
								</div>
								<div class="row">
									<div class="col-xs-6">
										<div class="form-group">
											<label for="Title" class="control-label col-xs-2">Title/Desig.</label>
											<div class="col-xs-10">
												<div class="input-group">
													<span class="input-group-addon"><i class="fa fa-building"></i></span>
													@Html.TextBoxFor(f => f.Title, new { Class = "form-control", placeholder = "Enter your designation in company" })
												</div>
												@Html.ValidationMessageFor(f => f.Title)
											</div>
										</div>
									</div>
								</div>
							</div>
						</fieldset>
						<fieldset>
							<legend>Address Details:</legend>
							<div id="address">
								<div class="row">
									<div class="col-xs-6">
										<div class="form-group">
											<label for="address" class="control-label col-xs-2">Address</label>
											<div class="col-xs-10">
												<div class="input-group">
													<span class="input-group-addon"><i class="fa fa-home"></i></span>
													@Html.TextAreaFor(f => f.Address, new { placeholder = "Enter your address", Class = "form-control" })
												</div>
												@Html.ValidationMessageFor(f => f.Address)
											</div>
										</div>
									</div>
									<div class="col-xs-6">
										<div class="form-group">
											<label for="zip" class="control-label col-xs-2">ZIP</label>
											<div class="col-xs-10 right-15">
												@Html.TextBoxFor(f => f.ZipCode, new { Class = "form-control", placeholder = "Enter ZIP code" })
												@Html.ValidationMessageFor(f => f.ZipCode)
											</div>
										</div>
									</div>

								</div>
								<div class="row">
									<div class="col-xs-6">
										<div class="form-group">
											<label for="city" class="control-label col-xs-2">City</label>
											<div class="col-xs-10">
												<div class="input-group">
													<span class="input-group-addon"><i class="fa fa-building"></i></span>
													@Html.TextBoxFor(f => f.City, new { Class = "form-control", placeholder = "Enter your city name" })
												</div>
												@Html.ValidationMessageFor(f => f.City)
											</div>
										</div>
									</div>
									<div class="col-xs-6">
										<div class="form-group">
											<label for="state" class="control-label col-xs-2">State</label>
											<div class="col-xs-10 right-15">
												@Html.TextBoxFor(f => f.State, new { Class = "form-control", placeholder = "Enter your state name" })
												@Html.ValidationMessageFor(f => f.State)
											</div>
										</div>
									</div>
								</div>
								<div class="row">
									<div class="col-xs-6">
										<div class="form-group">
											<label for="country" class="control-label col-xs-2">Country</label>
											<div class="col-xs-10">
												<div class="input-group">
													<span class="input-group-addon"><i class="fa fa-flag"></i></span>
													@Html.DropDownListFor(f => f.Country, (List<SelectListItem>)ViewBag.Countries, "-Select Country-", new { Class = "form-control selectpicker" })
												</div>
												@Html.ValidationMessageFor(f => f.Country)
											</div>
										</div>
									</div>
								</div>
							</div>
						</fieldset>
						<fieldset>
							<legend>Payment Details:</legend>
							<div id="payment">
								<div class="row">
									<div class="col-xs-6">
										<div class="form-group">
											<label class="control-label col-xs-2"></label>
										</div>
										<div class="col-xs-11">
											<img src="/captcha" style="margin-left:55px;" id="captcha" /> <a id="refresh" title="Refresh Captcha" style="cursor:pointer;"> <img src="~/images/012_restart-128.png" style="width:32px;" /></a>
										</div>

									</div>
								</div>
								<div class="row">
									<div class="col-xs-6">
										<div class="form-group">
											<label for="captcha" class="control-label col-xs-2">Captcha</label>
											<div class="col-xs-10 right-15">
												@Html.TextBoxFor(f => f.Captcha, new { Class = "form-control", placeholder = "Enter captcha" })
												@Html.ValidationMessageFor(f => f.Captcha)
											</div>
										</div>
									</div>
									<div class="col-xs-6">
										<div class="form-group">
											<label for="ptype" class="control-label col-xs-2">Payment</label>
											<div class="col-xs-10 right-15">
												@Html.DropDownListFor(f => f.PaymentType, new List<SelectListItem> {
											   new SelectListItem { Text = "-Select Payment-", Value = "" },
											   new SelectListItem { Text = "HDFC", Value = "3" },
											   new SelectListItem { Text = "PayPal", Value = "0" },
											   new SelectListItem { Text = "2Checkout", Value = "1", Selected = true },
											   new SelectListItem { Text = "CCAvenue", Value = "4" },
											   new SelectListItem { Text = "Wire Transfer", Value = "2" }
										   }, new { Class = "form-control", placeholder = "Select Payment" })
												@Html.ValidationMessageFor(f => f.PaymentType)
											</div>
										</div>
									</div>
								</div>
								<div class="row">
									<div class="col-md-8">
										<div class="form-row">
											<label for="card-element">
												Credit or debit card
											</label>
											<div id="card-element">
												<!-- A Stripe Element will be inserted here. -->
											</div>

											<!-- Used to display form errors. -->
											<div id="card-errors" role="alert"></div>
										</div>
									</div>
									<div class="col-md-4">
										<button id="btnStripe" class="btn btn-primary">Submit Payment</button>
										<div id="error"></div>
									</div>
								</div>
								<!-- A Stripe Element will be inserted here. -->
								@*<div id="payment-request-button">

									</div>
									<button id="btnStripePay" class="btn btn-lg btn-sunny">Stripe Pay</button>*@
								<div class="row">
									<div class="col-xs-12">
										<button type="button" id="btnPayNow" class="btn btn-danger btn-lg pull-right">Submit</button>
									</div>
								</div>
							</div>
						</fieldset>
					</div>
				</div>
