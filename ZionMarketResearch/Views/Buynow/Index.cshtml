				<div class="row">
					@*<div class="col-sm-8" title="@Model.OrderSummary[0].ReportTitle">@(Model.OrderSummary[0].ReportTitle.Length > 100 ? Model.OrderSummary[0].ReportTitle.Substring(0, 100) + "..." : Model.OrderSummary[0].ReportTitle)</div>*@
