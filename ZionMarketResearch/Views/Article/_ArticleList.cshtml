@model PagedList.IPagedList<ZionMarketResearch.Models.Article>
@using PagedList.Mvc
@foreach (var article in Model)
{
    <div class="heading reportlist_box">
        <div class="col-sm-12 zero-padding">
            <div class="topbadge">
                <span class="badge"><i class="fa fa-calendar" aria-hidden="true"></i>  @article.PublishedDate.Value.ToString("dd-MMM-yyyy") </span>
            </div>
            <h2 class="reporttitle"> <a href="@Url.Action("Index", "Article", new { url = article.Url })">@article.Title</a></h2>
            <p>@ZionMarketResearch.Util.Utility.StripHTML(article.Description).ZSubstring(0, 299) <span><a href="@Url.Action("Index", "Article", new { url = article.Url })" rel="nofollow" style="color:#123456!important;">Read More <i class="fa fa-arrow-circle-right"></i></a></span></p>
        </div>
    </div>
}
@{ Html.RenderPartial("_TotalRecord", ViewData.Model); }
@Html.PagedListPager(Model, p => Url.Action("AllArticles", "Article", new { page = p }), GlobalConstant.GlobalPagedListOption)