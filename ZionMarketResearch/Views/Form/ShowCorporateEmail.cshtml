<style>
    .full {
        width: 100%;
        float: left;
    }

    .inner_bg {
        position: relative;
        margin-bottom: 50px;
        background: 0 0;
    }

    .tanks_page_sec {
        border-top: 0px solid #ddd;
        min-height: 620px;
        padding: 70px 0 0;
        background: #f5fafc;
    }

    .new_alert_thanks {
        padding: 30px 0;
    }

    img {
        max-width: 100%;
        height: auto;
    }

    h3 {
        font-size: 20px;
    }

    .reqest-box {
        background: #f5fafc;
    }

    .reqest-box {
        width: 100%;
        display: block;
        margin-top: -10px;
        padding: 20px 25px;
    }

    .contact_us button[type="submit"] {
        margin: -8px 0 5px;
        vertical-align: -webkit-baseline-middle;
        padding: 5px 20px;
        font-size: 14px;
    }

    .contact_us button[type=submit]:hover {
        background: #5ccbf5;
    }

    .contact_us button[type=submit] {
        background: #17a2b8;
        border: 0;
        border-radius: 6px;
        box-shadow: none;
        color: #fff;
        font-size: 15px;
        height: auto;
        margin: 10px 0 5px;
        padding: 6px 20px;
        width: auto !important;
        box-shadow: 0 1px 0 0 rgb(0 0 0 / 15%), 0 2px 2px 0 rgb(0 0 0 / 10%);
    }
</style>

<section class="section_gap">
    <div class="container" style="margin-top:35px">
        <div class="full">
            <center>
                <div class="container new_alert_thanks">
                    <img src="../images/check_12.webp" width="60" alt="check">
                    <h3>Please provide your company email address for a faster response</h3>

                    <div id="target_div_update">

                        <form class="contact_us" action="/form/CorporateEmailSubmit" method="post" id="contact_form_@ViewBag.FormType" style="background-color:inherit;border:none;">
                            <input type="hidden" id="CrmLeadID" name="CrmLeadID" value="@ViewBag.CrmLeadID">
                            <input type="hidden" id="Id" name="Id" value="@ViewBag.Id">
                            <input type="text" id="Email" name="Email" value="@ViewBag.Email" placeholder="myname@example.com" class="form-control required" style="width:300px; margin-right:15px;border-radius:4px;">
                            @*@Html.TextBoxFor(f => f.Email, new { placeholder = "myname@example.com", Class = "form-control" })*@

                            @Html.ValidationMessageFor(f => f.Email)

                            <button type="submit" class="buy_now buy_now_2" style="width:auto;border-radius:4px;">Submit</button>

                        </form>
                        @{ if (Session["ShowErr"]!=null)
                            {
                        <div class="alert alert-danger" style="width:60%; margin-top:10px;">
                            Alert! Generic email address not acceptable. Please, try with a corporate email address.
                        </div>
                                }
                            }
                    </div>

                </div>
            </center>
        </div>
    </div>
</section>
@*</div>
                </div>
            </div>
        </main>
    </section>*@
