            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 noPadd slides-container" style="height:100%; margin:0; padding:0; list-style:none; position:relative;">
                <!--background slide show start-->
                <div class="slide">
                    <!--slid1 start-->
                    <div class="container hedaer-inner">
                        <div class="bannerText">
                            <h2>Market research is a multi faceted discipline, where requirements may vary in line with the strategic needs of an organization.</h2>
                            <p>Zion Market Research also identifies new growth opportunities to help you successfully establish and expand your business.</p>
                            <p><a href="#course" class="smooth">View  More... <i class="fa fa-angle-right"></i></a></p>
                        </div>
                    </div>
                    <!--slid1 end-->
                    <img src="/images/image01-640.webp"
                         srcset="
                                /images/image01-640.webp 640w,
                                /images/image01-1024.webp 1024w,
                                /images/image01-1440.webp 1440w,
                                /images/image01-1920.webp 1920w
                                "
                         sizes="(max-width: 640px) 640px, (max-width: 1024px) 1024px, (max-width: 1440px) 1440px, 1920px"
                         alt="image01"
                         @*width="1920"
                         height="800"*@
                         loading="eager"
                         fetchpriority="high"
                         decoding="async"
                         style="width:100%; height:100%; object-fit:cover;"/>

                    @*<img src="~/images/image01.webp" alt="image01" width="1920"
            height="800"
            fetchpriority="high"
            decoding="async" />*@
