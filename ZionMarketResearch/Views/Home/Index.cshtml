@section IndexScripts{
    <script defer src="/Scripts/serializeform.js"></script>
    <script defer src="~/Content/js/jquery.superslides.js"></script>

    <script defer>
        (function () {
            if (typeof jQuery === 'undefined') return;

            // ── FIX 1: intercept removeAttr ──────────────────────────────────
            var _removeAttr = $.fn.removeAttr;
            $.fn.removeAttr = function (name) {
                if (
                    (name === 'width' || name === 'height') &&
                    this[0] &&
                    this[0].tagName === 'IMG' &&
                    this.closest('#banner').length
                ) {
                    return this;
                }
                return _removeAttr.apply(this, arguments);
            };

            // ── FIX 2: intercept css() for banner images + block #banner height mutation
            var _css = $.fn.css;
            $.fn.css = function (prop) {
                // Block superslides mutating #banner height after first paint
                if (
                    this[0] &&
                    this[0].id === 'banner' &&
                    typeof prop === 'object' &&
                    prop['height'] !== undefined &&
                    prop['position'] === undefined
                ) {
                    delete prop['height'];
                    if (Object.keys(prop).length === 0) return this;
                }

                // Fix unsized banner images
                if (
                    this[0] &&
                    this[0].tagName === 'IMG' &&
                    this.closest('#banner').length &&
                    typeof prop === 'object' &&
                    prop['-webkit-backface-visibility'] === 'hidden'
                ) {
                    prop['width'] = '100%';
                    prop['height'] = '100%';
                    prop['object-fit'] = 'cover';
                    prop['max-width'] = '100%';
                }
                return _css.apply(this, arguments);
            };

            // ── FIX 3: intercept fadeIn on slides-container ───────────────────
            var _fadeIn = $.fn.fadeIn;
            $.fn.fadeIn = function (speed, callback) {
                if (this.hasClass('slides-container')) {
                    if (typeof callback === 'function') callback();
                    return this.show();
                }
                return _fadeIn.apply(this, arguments);
            };

        }());

        // ── Superslides + Carousels init ──────────────────────────────────────
        document.addEventListener("DOMContentLoaded", function () {

            // ── Superslides init ──────────────────────────────────────────────
            if ($.fn.superslides) {
                var bannerEl = document.getElementById('banner');
                var bannerH = bannerEl ? bannerEl.offsetHeight : window.innerHeight;

                var initSlider = function () {
                    $('.header_v3 #banner').superslides({
                        animation: 'fade',
                        play: 5000,
                        inherit_width_from: bannerEl,
                        inherit_height_from: {
                            jquery: '3.7.1',
                            0: bannerEl,
                            height: function () { return bannerH; },
                            width: function () { return bannerEl ? bannerEl.offsetWidth : window.innerWidth; }
                        }
                    });
                };

                // Wait for LCP image to load before starting slider
                var lcpImg = document.querySelector('#banner .slide:first-child img');
                if (lcpImg && !lcpImg.complete) {
                    lcpImg.addEventListener('load', initSlider);
                } else {
                    initSlider();
                }
            }

            // ── Carousels ─────────────────────────────────────────────────────
            if ('IntersectionObserver' in window) {
                var carousels = [
                    { id: '#carousel-testimonial', interval: 4000 },
                    { id: '#myclientCarousel', interval: 3000 }
                ];
                carousels.forEach(function (cfg) {
                    var el = document.querySelector(cfg.id);
                    if (!el) return;
                    var obs = new IntersectionObserver(function (entries) {
                        if (!entries[0].isIntersecting) return;
                        $(cfg.id).carousel({ interval: cfg.interval });
                        obs.disconnect();
                    }, { threshold: 0.1 });
                    obs.observe(el);
                });
            } else {
                $('#carousel-testimonial').carousel({ interval: 4000 });
                $('#myclientCarousel').carousel({ interval: 3000 });
            }
        });
    </script>


}