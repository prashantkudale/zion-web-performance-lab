@{ ViewBag.Title = "Zion Market Research - Market Intelligence Reports, Business Consulting Services and Solutions";
    ViewBag.MetaDescription = "The Industry Research Firm Zion Market Research Delivers Market Intelligence Reports, Custom Regional Analysis and Consulting Services with Forecast Market Growth";
    ViewBag.MetaKeywords = "Market Research Reports, Market Trends, Market Share, Market Size, Industry Analysis, Market Forecast, Revenue, marketing research company, Market Research, ZMR, Zion Market Research";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section HeadPreloads {
    @*
        Preload the LCP hero image with correct responsive srcset hints.
        This fires at the very top of <head> (before fonts, CSS, JS)
        so the image fetch starts in parallel with everything else.
        imagesrcset lets the browser pick the right size for the viewport.
    *@
<link rel="preload" as="image"
      href="/images/image01-1440.webp"
      imagesrcset="/images/image01-640.webp 640w,
                   /images/image01-1024.webp 1024w,
                   /images/image01-1440.webp 1440w,
                   /images/image01-1920.webp 1920w"
      imagesizes="(max-width: 640px) 640px, (max-width: 1024px) 1024px, (max-width: 1440px) 1440px, 1920px"
      fetchpriority="high">
}

<!--Header start -->
<header>
    @{ Html.RenderAction("NavigationMenu", "Home"); }
    <!--banner start v3-->
    <div class="header_v3">
        <div class="banner row" id="banner">
            <div class="">
                @{ Html.RenderPartial("_SearchHome"); }
