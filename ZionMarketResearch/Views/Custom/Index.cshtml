@model ZionMarketResearch.Models.CustomView
@{
    ViewBag.Title = "Request for customization: " + Model.ReportTitle.Substring(0, Model.ReportTitle.ToLower().IndexOf("market") + 6);
    Layout = "~/Views/Shared/_LayoutInternal.cshtml";
}
@{ Html.RenderPartial("_breadcrumb", "<a href='" + Url.Action("Index", "Report", new { url = Model.ReportUrl }) + "' title='" + Model.ReportTitle + "'>Back to Report: " + Model.ReportTitle.Substring(0, Model.ReportTitle.ToLower().IndexOf("market") + 6) + "</a>|Request Customisation"); }
<div class="row">
    <div class="col-md-8">
        <h3 class="text-center">@(Request.QueryString["covid19"] != null && Convert.ToBoolean(Request.QueryString["covid19"]) ? "Request COVID-19 Impact on the industry" : "Request Customization")</h3>
        <h1 class="reporttitle">@Model.ReportTitle</h1>
        <div class="alert alert-info">
            <b>Please fill your details below, to request for customize this report:</b>
            <div style="font-size:15px;width:100%;"><label class="control-label required"></label> Indicates required fields</div>
        </div>
        @{ Html.RenderAction("ShowForm", "Form", new { FormType = 3, ReportId = ZionMarketResearch.Util.Utility.Encryptstring(Model.ReportId.ToString()) }); }
    </div>
    <div class="col-md-4">
        <div class="panel panel-primary">
            <div class="panel-heading"><strong>Contact</strong></div>
            <div class="panel-body">
                <p>
                    US OFFICE # - +1-386-310-3803<br /><br />
                    GMT OFFICE HOURS - +49 322 210 92714<br /><br />
                    US/CAN TOLL FREE - +1-855-465-4651<br /><br />
                    E-Mail - sales@zionmarketresearch.com
                </p>
            </div>
        </div>
        @{ Html.RenderAction("latestreport", "report"); }
    </div>
</div>
<script>
    ScrollMe(".reporttitle");
</script>