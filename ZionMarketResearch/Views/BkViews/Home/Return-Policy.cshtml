@{
    ViewBag.Title = "Return Policy: Zion Market Research";
    Layout = "~/Views/Shared/_LayoutInternal.cshtml";
    ViewBag.MetaDescription = "Return Policy: Zion Market Research";
    ViewBag.MetaKeywords = "Return Policy,Zion Market Research";
}

<section id="report-title" class="white_section section_gap">
    @{ Html.RenderPartial("_NewSearch"); }
    <div class="container">
        @{ Html.RenderPartial("_breadcrumb", "Return Policy"); }
        <div class="col-md-8 white_section">
            <div class="DNNContainer_Title_h2 SpacingBottom">
                <h2 class="reporttitle">
                    Return Policy
                </h2>
                <div id="dnn_ctr704_ContentPane">
                    <!-- Start_Module_704 -->
                    <div id="dnn_ctr704_ModuleContent" class="DNNModuleContent ModDNNHTMLC">
                        <div id="dnn_ctr704_HtmlModule_lblContent" class="Normal">
                            <p class="text"><span style="color: #333333;"></span></p>
                            <p style="text-align: left;">
                                The easily transferable nature of the value of information products, Zion Market Research maintains a "no return" policy. Please be sure to read all available information about a report before you place your order. A table of contents and summary are available for all of our products, and samples of many reports can be viewed for free.<br>
                                <br>
                                If you have any questions about a report's coverage or relevance, simply contact us at <a href="mailto:sales@zionmarketresearch.com" class="ApplyClass"><strong><span style="font-size: 13px;">sales@zionmarketresearch.com</span></strong></a> for expert assistance from a Research Specialist.
                            </p>
                        </div>

                    </div>
                    <!-- End_Module_704 -->
                </div>
                <div class="clear"></div>
            </div>
        </div>
        <div class="col-md-4 divtopmargin">
            @{ Html.RenderPartial("_contact"); }
        </div>
    </div>
</section>
@section metaTags{
    <meta name="robots" content="noindex" />
}