@model PagedList.IPagedList<ZionMarketResearch.Models.SearchResultView>

@foreach (var report in Model)
{
    <div class="heading reportlist_box">
        <div class="col-sm-10 zero-padding">
            <div class="topbadge">
                @if (report.PublishedDate != null)
                { <span class="badge"><i class="fa fa-calendar" aria-hidden="true"></i>  @report.PublishedDate.Value.ToString("dd-MMM-yyyy") </span>}
                <span class="badge"> <i class="fa fa-tags" aria-hidden="true"></i> @(!report.IsUpcoming ? "Published" : "Upcoming")  </span>
            </div>
            <h2 class="reporttitle"> <a href="@Url.Action("Index", "Report", new { url = report.ReportUrl })">@report.ReportTitle</a></h2>
            @if (report.Categories != null && report.Categories.Length > 0)
            {<span class="bottombadge"><i class="fa fa-th-large" aria-hidden="true"></i> @Html.Raw(report.Categories[@report.Categories.Length - 1]) </span>} <span class="bottombadge"><i class="fa fa-file-pdf-o"></i> Report Format : PDF</span> <span class="bottombadge"> <i class="fa fa-book" aria-hidden="true"></i> Pages: @report.NumberOfPages </span>
            <span class="bottombadge"> <i class="fa fa-pencil-square-o" aria-hidden="true"></i> Report Code: ZMR-@report.ReportId </span>
        </div>
        <div class="col-sm-2 text-center lt-border">

            <div class="rb_btn">
                <h2> $ @report.SingleUser.Value.ToString("##") <small> Single User </small></h2>
                <a class="btn btn-warning btn-lg btn-block" href="@Url.Action(!report.IsUpcoming ? "Index" : "Prebook", "BuyNow", new { url = report.ReportUrl, reporttype="su" })" rel="nofollow"> @(!report.IsUpcoming ? "Buy Now" : "Prebook") </a>
            </div>

        </div>
    </div>
}