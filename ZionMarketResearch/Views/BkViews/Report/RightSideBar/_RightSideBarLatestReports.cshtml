@model IEnumerable<ZionMarketResearch.Models.LatestReportView>
<div class="panel panel-primary">
    <div class="panel-heading"><strong><i class="fa fa-file-text" aria-hidden="true"></i> Latest Published Reports</strong></div>
    @foreach (var report in Model)
    {
        <div class="panel-body">
            <p>@(report.PublishedDate != null ? Html.Raw("<i class=\"fa fa-calendar\"></i> " + report.PublishedDate.Value.ToString("dd-MMM-yyyy") + " | ") : Html.Raw("")) @(report.Categories != null && report.Categories.Count() > 0 ? report.Categories[report.Categories.Length - 1] : string.Empty)</p>
            <a href="@Url.Action("Index", "Report", new { url = report.ReportUrl })">
                <h3>@report.ReportTitle</h3>
            </a>
        </div>
    }
    <p class="read-more"><a href="@Url.Action("AllReports","Report")" rel="nofollow">View All Published Reports <i class="fa fa-arrow-circle-right"></i></a></p>
</div>
