@model ZionMarketResearch.Models.MainPageReportView
@{
    var isDiscount = Session["Discount"] != null ? true : false;
}
<div class="newBuynow" id="chooselicense">
    @*<span>Choose License</span>*@
    <i class="fa fa-question-circle" id="chooseToolTip" data-toggle="tooltip" data-placement="right" data-html="true" style="float:left;margin-top:10px;"></i>
    @*<select id="chooseLicenseType">
            <option value="@Model.SingleUserLink">Single User | $ @Model.SingleUser USD</option>
            <option value="@Model.MultiUserLink">Multi User | $ @Model.MultiUser USD</option>
            <option value="@Model.CorporateUserLink">Corporate User | $ @Model.CorporateUser USD</option>
        </select>*@
    <div id="dd" class="wrapper-dropdown-3">
        <span>Choose License</span>
        <ul class="dropdown">
            <li value="@Model.SingleUserLink" class="defaultSelected">
                <a href="#">
                    Single User | $ @if (isDiscount)
            { <span style="text-decoration:line-through; color:red;">@Model.SingleUser</span> @((Model.SingleUser - (Model.SingleUser * (decimal)0.3)).ToString("0.00")) }
                    else
                    { @Model.SingleUser } USD
                </a>
            </li>
            <li value="@Model.MultiUserLink">
                <a href="#">
                    Multi User | $ @if (isDiscount)
            {<span style="text-decoration:line-through; color:red;">@Model.MultiUser</span> @(((decimal)(Model.MultiUser - (Model.MultiUser * (decimal)0.30))).ToString("0.00")) }
                    else
                    { @Model.MultiUser } USD
                </a>
            </li>
            <li value="@Model.CorporateUserLink">
                <a href="#">
                    Corporate User | $ @if (isDiscount)
            {<span style="text-decoration:line-through; color:red;">@Model.CorporateUser</span> @(((decimal)(Model.CorporateUser - (Model.CorporateUser * (decimal)0.30))).ToString("0.00"))}
                    else
                    { @Model.CorporateUser } USD
                </a>
            </li>
        </ul>
    </div>

    <button class="btn text-uppercase btn-hot" onclick="jsRedirect(dd.getValue());">@(Model.IsUpcoming ? "Pre Book Now" : "Buy Now")</button>
    <button class="btn text-uppercase btn-primary" onclick="jsRedirect('/custom/@Model.ReportId');">Request Customization</button>
    @if (Model.FreeAnalysis == null || string.IsNullOrEmpty(Model.FreeAnalysis))
    {
        <button class="btn text-uppercase btn-fresh" onclick="jsRedirect('@Model.FreeAnalysisLink')" style="display:none;">Ask For Analyst</button>
    }
    <a href="@Url.Action("RequestBrochure", "Report", new { url = Model.URL })" class="btn btn-sunny text-uppercase">Request Free Brochure</a>
    <a href="@Url.Action("RequestDiscount", "Report", new { url = Model.URL })" class="btn btn-sky text-uppercase">Request Discount</a>
</div>

<!--Button Style-->
<style>
