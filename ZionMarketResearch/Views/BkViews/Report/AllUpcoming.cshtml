@model PagedList.IPagedList<ZionMarketResearch.Models.SearchResultView>
@using PagedList.Mvc
@{
    ViewBag.Title = "All Upcoming Reports: Zion Market Research";
    Layout = "~/Views/Shared/_LayoutInternal.cshtml";
    ViewBag.MetaDescription = "Zion Market Research offers all market uocoming reports covering different research categories.";
    ViewBag.MetaKeywords = "Market research reports, market research, industry research reports, market research analysis, market size, market share, industry trends";
}

<section id="report-title" class="white_section section_gap">
    @{ Html.RenderPartial("_NewSearch"); }
    <div class="container">
        @{ Html.RenderPartial("_breadcrumb", "All Upcoming"); }
        <div class="col-sm-9 col-xs-12">
            @{ Html.RenderPartial("_ReportList", Model); }
            @{ Html.RenderPartial("_TotalRecord", ViewData.Model); }
            @Html.PagedListPager(Model, p => Url.Action("AllUpcoming", "Report", new { page = p }), GlobalConstant.GlobalPagedListOption)
        </div>
    </div>
</section>
