@model List<ZionMarketResearch.Models.LatestNewsView>
<!--Bottom Four Column start-->
<section class="blue_section section_gap">
    <div class="container-fluid">
        <div class="row bottomfourcol">
            <!-- Footer About us start-->
            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 bottomAbout">
                <!-- <h5 class="heading">About us</h5>
                 <p>Zion Market Research is an obligated company. We create futuristic, cutting edge, informative reports ranging from industry reports, company reports to country reports..</p>
                 -->

                <h5 class="heading">Office Address</h5>

                <p>
                    Corporate Office<br/>
                    Zion Market Research
                    244 Fifth Avenue, Suite N202
                    New York, 10001, United States<br />

                    Tel: <a href="tel:+49-322 210 92714">+49-322 210 92714</a><br />
                    USA/Canada Toll Free No.<a href="tel:1-855-465-4651">1-855-465-4651</a>
                </p>
                <p>
                    Asia Pacific Office<br />
                    3rd Floor,
                    Mrunal Paradise, Opp Maharaja Hotel,
                    Pimple Gurav, Pune 411061,
                    Maharashtra, India<br />
                    Phone No <a href="tel:020-46277770">020-46277770</a>
                </p>
                <p>
                    Contact #<br />
                    US OFFICE NO <a href="tel:+1-386-310-3803">+1-386-310-3803</a><br />
                    US/CAN TOLL FREE <a href="tel:+1-855-465-4651">+1-855-465-4651</a><br />
                    Email: <a href="mailto:sales@zionmarketresearch.com">sales@zionmarketresearch.com</a>
                </p>



            </div>
            <!-- Footer About us end-->
            <!-- Footer Recent news start-->
            <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                <h5 class="heading">Industry Press Release</h5>
                <ul class="footerLinks">
                    @foreach (var n in Model)
                    {
                        <li> <a href="@Url.Action("Index", "News", new { url = n.NewsUrl })">@n.NewsTitle</a> <span>by <a href="/">Zion Market Research</a> on @n.PublishedDate.Value.ToString("dd-MMM-yyyy")</span> </li>
                    }
                </ul>
            </div>
            <!-- Footer Recent news end-->
            <!-- Footer How it works start-->
            <div class="col-lg-2 col-md-2 col-sm-6 col-xs-12">
                <h5 class="heading">How it Works?</h5>

                <ul class="how-it-work list">
                    <li><a href="@Url.Action("HowToOrder", "Home")" rel="nofollow"><i class="fa fa-angle-double-right" aria-hidden="true"></i> How to Order</a></li>
                    <li><a href="@Url.Action("Disclaimer", "Home")" rel="nofollow"><i class="fa fa-angle-double-right" aria-hidden="true"></i> Disclaimer</a></li>
                    <li><a href="@Url.Action("FAQ", "Home")" rel="nofollow"><i class="fa fa-angle-double-right" aria-hidden="true"></i> FAQs</a></li>
                    <li><a href="@Url.Action("ReturnPolicy", "Home")" rel="nofollow"><i class="fa fa-angle-double-right" aria-hidden="true"></i> Return Policy</a></li>
                    <li><a href="@Url.Action("MainSitemap", "Sitemap")" rel="nofollow"><i class="fa fa-angle-double-right" aria-hidden="true"></i> Sitemap</a></li>

                </ul>
                <h5 class="heading">Our Company</h5>
                <ul class="our-company list">
                    <li><a href="@Url.Action("AboutUs", "Home")" rel="nofollow"><i class="fa fa-angle-double-right" aria-hidden="true"></i> About Us</a></li>
                    <li><a href="@Url.Action("TermsNCondition", "Home")" rel="nofollow"><i class="fa fa-angle-double-right" aria-hidden="true"></i> Terms and Conditions</a><a></a></li>

                    <li><a href="@Url.Action("ContactUs", "Home")" rel="nofollow"><i class="fa fa-angle-double-right" aria-hidden="true"></i> Contact Us</a></li>

                    <li><a href="@Url.Action("PrivacyPolicy", "Home")" rel="nofollow"><i class="fa fa-angle-double-right" aria-hidden="true"></i> Privacy Policy</a></li>
                    <li><a href="@Url.Action("ZMRInNews", "Home")" rel="nofollow"><i class="fa fa-angle-double-right" aria-hidden="true"></i> ZMR in News</a></li>
                    <li><a href="@Url.Action("Career", "Home")" rel="nofollow"><i class="fa fa-angle-double-right" aria-hidden="true"></i> Career</a></li>
                </ul>
            </div>
            <!-- Footer How it works end-->
            <!-- Footer we accept start-->
            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 contactInfo">
                <h5 class="heading">We Accept</h5>
                <p>We have secured system to process your transaction.</p>
                <ul>
                    <li><img src="~/images/paypal.gif" width="31" height="22" alt="" /></li>
                    <li><img src="~/images/amazon.gif" width="31" height="22" alt="" /></li>
                    <li><img src="~/images/visa.gif" width="31" height="22" alt="" /></li>
                    <li><img src="~/images/master.gif" width="31" height="22" alt="" /></li>
                    <li><img src="~/images/discover.gif" width="31" height="22" alt="" /></li>
                </ul>
                <br />
                <h5>We Are On Social</h5>
                <div class="socialshare">
                    <a href="https://twitter.com/zion_research" rel="nofollow"><i class="fa fa-twitter"></i></a>
                    <a href="https://www.facebook.com/zionmarketresearch" rel="nofollow"><i class="fa fa-facebook"></i></a>
                    <a href="https://www.linkedin.com/company/zion-market-research" rel="nofollow"><i class="fa fa-linkedin"></i></a>
                </div>
            </div>
            <!-- Footer we accept end-->
        </div>
    </div>
</section>
<!--/Bottom Four Column end -->
<!--Footer start-->
<footer class="footer">
    <div class="container">
        <div class="row">
            <div class="pull-left">
                <p>Copyright © @DateTime.Now.Year - @(DateTime.Now.Year + 1), All Rights Reserved by Zion Market Research</p>
            </div>
            <div class="pull-right"><a class="gototop smooth" href="#wrapper">Go To Top<i class="fa fa-chevron-up"></i></a></div>
        </div>
    </div>
</footer>
<!--Footer end -->
<!--wrapper end-->
