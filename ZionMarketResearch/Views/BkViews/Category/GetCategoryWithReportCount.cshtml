@model List<ZionMarketResearch.Models.CategoryReportView>
<div class="bs-example">
    <div class="list-group">
        <a href="#" class="list-group-item active">
            <span></span> Category List
        </a>
        @foreach (var cat in Model)
        {
            <a href="@cat.CategoryUrl" class="list-group-item">
                <span></span> @cat.CategoryName
            </a>
        }
    </div>
</div>