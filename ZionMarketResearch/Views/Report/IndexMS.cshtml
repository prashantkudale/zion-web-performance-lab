<style>
    .pulse-button {
        position: relative;
        /*width: 100px;
    height: 100px;*/
        padding: 15px 30px 15px 30px !important;
        border: none;
        box-shadow: 0 0 0 0 rgba(255, 191, 9, 0.7);
        border-radius: 25px;
        font-weight: bold;
        font-size: 17px;
        background-color: #ffbf09;
        cursor: pointer;
        -webkit-animation: pulse 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
        -moz-animation: pulse 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
        -ms-animation: pulse 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
        animation: pulse 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
        color: black;
    }

        .pulse-button:hover {
            -webkit-animation: none;
            -moz-animation: none;
            -ms-animation: none;
            animation: none;
            color: #ffffff;
        }

    @@-webkit-keyframes pulse {
        to {
            box-shadow: 0 0 0 15px rgba(232, 76, 61, 0);
        }
    }

    @@-moz-keyframes pulse {
        to {
            box-shadow: 0 0 0 15px rgba(232, 76, 61, 0);
        }
    }

    @@-ms-keyframes pulse {
        to {
            box-shadow: 0 0 0 15px rgba(232, 76, 61, 0);
        }
    }

    @@keyframes pulse {
        to {
            box-shadow: 0 0 0 15px rgba(232, 76, 61, 0);
        }
    }


    .report-box {
        margin-top: 5px;
        background: #fdffff;
        -webkit-border-radius: 0.5rem;
        -moz-border-radius: 0.5rem;
        -ms-border-radius: 0.5rem;
        border-radius: 0.5rem;
        padding: 2.0rem;
        -webkit-box-shadow: 0 1px 1px 1px #ebebeb;
        /* box-shadow: 0 1px 6px 4px #ebebeb; */
        box-shadow: rgb(14 30 37 / 12%) 0px 2px 4px 0px, rgb(14 30 37 / 32%) 0px 2px 16px 0px;
    }

        .report-box input[type="radio"]:checked + label {
            border: none;
            background: #fff !important;
        }

        .report-box ul li img {
            height: auto;
            display: inline;
        }

    #covid-19_sec {
        height: 500px;
        width: auto;
        background-image: url(/images/covid-19_bg2.png);
    }

        #covid-19_sec p {
            padding: 138px 10px 20px 30px;
            width: 100%;
            font-size: 18px !important;
            font-weight: bold;
            color: #ffffff;
        }

            #covid-19_sec p a {
                bottom: 0;
                color: #000000 !important;
            }
</style>
