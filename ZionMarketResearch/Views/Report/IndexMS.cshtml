@if (userIdentity != null && (userIdentity.IsInRole("Admin") || userIdentity.IsInRole("EditReport")))
{

    <script src="/Areas/Admin/Content/js/ckeditor_4.11.3_standard/ckeditor/ckeditor.js"></script>
    <script>
                    var descriptionEditor = CKEDITOR.inline('Descriptionss');

                    $("#Descriptionss").attr('contenteditable', 'true');
                    //CKEDITOR.inline('TableOfContentss');

                    //descriptionEditor.config.disallowed = 'table';

                    function UpdateChanges() {
                        $.ajax({
                            url: '/updatereportdescription',
                            type: 'POST',
                            contentType: 'application/json; charset=utf-8',
                            data: JSON.stringify({
                                ReportID: @ZionMarketResearch.Util.Utility.Decryptstring(ViewBag.ReportID),
                                ReportDescription: descriptionEditor.getData(),
                                CopyToReseller: $("#copyToReseller").prop('checked')
                            }),
                            success: function (res) {
                                if (res > 0) {
                                    alert('Report has been updated.');
                                }
                            },
                            error: function (err) {
                                console.log(err);
                            }
                        });
                    }
    </script>
}

<script>

    $(document).ready(function () {
        var urlSegment = document.URL.split("/");
        if (urlSegment[urlSegment.length - 2] === 'toc') {
            $('.nav-tabs a[data-target="TableOfContent"]').tab('show');
            $("#TableOfContent").addClass("in active");
        } else if (urlSegment[urlSegment.length - 2] === 'report') {
            $('.nav-tabs a[data-target="Description"]').tab('show');
            $("#Description").addClass("in active");
        } else if (urlSegment[urlSegment.length - 2] === 'methodology') {
            $('.nav-tabs a[data-target="Methodology"]').tab('show');
            $("#Methodology").addClass("in active");
        } else if (urlSegment[urlSegment.length - 2] === 'market-analysis') {
            $('.nav-tabs a[data-target="FreeAnalysis"]').tab('show');
            $("#FreeAnalysis").addClass("in active");
        }
        //var reportDescImg = $("#report-desc img");

        //$(reportDescImg).addClass("img-responsive");
        //$(reportDescImg).css("margin", "0 auto");


    });
</script>
@if (!Request.Browser.IsMobileDevice)
{
    <script>
        window.onscroll = function () { myFunction() };

        // Get the header
        var header = document.getElementById("reportButtons");

        // Get the offset position of the navbar
        var sticky = header.offsetTop;

        var buynow = document.getElementsByClassName('buynow-control');
        var buynowOffset = buynow[0].offsetHeight;

        // Add the sticky class to the header when you reach its scroll position. Remove "sticky" when you leave the scroll position
        function myFunction() {
            if (window.pageYOffset > sticky) {
                header.classList.add("sticky");
                header.classList.remove("row");
                header.classList.remove("hide");
            } else {
                header.classList.remove("sticky");
                header.classList.add("row");
                header.classList.add("hide");
            }
            if (window.pageYOffset > buynowOffset + 1000) {
                $(".buynow-control").addClass("sticky-right-sidebar");
            } else {
                $(".buynow-control").removeClass("sticky-right-sidebar");
            }

            if (window.pageYOffset > $(".buynow-control").parent()[0].offsetHeight + 1000) {
                $(".buynow-control").addClass('stick-to-bottm');
            } else {
                $(".buynow-control").removeClass('stick-to-bottm');
            }

        }


    </script>
}

