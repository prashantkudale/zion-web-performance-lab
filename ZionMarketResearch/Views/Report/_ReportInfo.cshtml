@model ZionMarketResearch.Models.MainPageReportView
@{ var marketColanExist = Model.ReportTitle.Contains("Market:");
    var smallTitleIndex = Model.ReportTitle.IndexOf(new string[] { " Market ", " Market:", " Market,", " Market-", ":" });
    var h1Title = smallTitleIndex > -1 ? Model.ReportTitle.Substring(0, smallTitleIndex).Replace("Global ", string.Empty) : Model.ReportUrl.Replace("-", " ").ToProperCasing().Replace("Global", string.Empty).Replace(" Market", string.Empty); }
<div class="heading">
    <div class="col-md-2" style="width: 11.666667%;">
        <div class="reportin-info">
            <img fetchpriority="high" loading="eager" decoding="sync" src="~/images/report_img.webp" class="img-responsive" width="148" height="176" alt="@h1Title Market">
        </div>
    </div>
    <div class="col-md-10">
        <h2 class="reporttitle animate__animated animate__bounce" style="position:relative;">
            @if (Request.Path.Contains("/market-analysis/"))
            {@Model.MetaTitle}
        else
        {@Model.ReportTitle}
        </h2>
    </div>
    <div class="reportin-info divcenter moHide">
        @if (Model.Categories != null && Model.Categories.Length > 0)
        {
    <span class="badge"><i class="fa fa-th-large" aria-hidden="true"></i> Category: @Html.Raw(Model.Categories[Model.Categories.Length - 1])</span>}
        <span class="badge"><i class="fa fa-file-pdf-o"></i> Report Format : PDF</span>
        @if (Model.NumberOfPages != null && Model.NumberOfPages > 0)
        {
    <span class="badge"><i class="fa fa-book" aria-hidden="true"></i> Pages: @Model.NumberOfPages</span>}
        <span class="badge"><i class="fa fa-pencil-square-o" aria-hidden="true"></i> Report Code: ZMR-@Model.ReportId</span>
        @if (Model.PublishedDate != null)
        {
    <span class="badge"><i class="fa fa-calendar" aria-hidden="true"></i> Published Date: @Model.PublishedDate.Value.ToString("MMM-yyyy")</span>}
        <span class="badge"><i class="fa fa-tags" aria-hidden="true"></i> Status : @(!Model.IsUpcoming ? "Published" : "Upcoming")</span>
    </div>
    @if (!string.IsNullOrEmpty(Model.MetaDescriptionTOC))
    {
<div class="title-summary">
    @Html.Raw(Model.MetaDescriptionTOC)
</div> }
else if (!string.IsNullOrEmpty(Model.MetaDescription))
{
<p class="title-summary">
    <i class="fa fa-quote-left"></i> @if (!Request.Path.Contains("/market-analysis/"))
    {@Model.MetaDescription} <i class="fa fa-quote-right"></i>
</p>}
</div>