@model ZionMarketResearch.Models.NotifyMeRepository
<!-- Modal -->
<div id="myModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Notify Me</h4>
            </div>
            <div class="modal-body">
                <p class="alert alert-info">
                    <i class="fa fa-info-circle"></i> <strong>You can enter your email to get notification when report published.</strong>
                </p>
                <form class="form-horizontal" id="frmNotify">
                    <div class="form-group">
                        <label for="name" class="col-sm-2 control-label">Name : </label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(f => f.Name, new { Class = "form-control notifyme-input", placeholder = "Enter your name (Required)" })
                            @Html.ValidationMessageFor(f => f.Name)
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="email" class="col-sm-2 control-label">Email : </label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(f => f.Email, new { Class = "form-control notifyme-input", placeholder = "Enter Email id (Required)" })
                            @Html.ValidationMessageFor(f => f.Email)
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="email" class="col-sm-2 control-label">Phone : </label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(f => f.Phone, new { Class = "form-control notifyme-input", placeholder = "Enter phone # (Optional)" })
                            @Html.ValidationMessageFor(f => f.Phone)
                        </div>
                    </div>
                    @*<div class="form-group" style="margin-bottom:0px !important;">
                            <label for="email" class="col-sm-2 control-label"></label>
                            <div class="col-sm-10">
                                <label class="checbox-label disabled">
                                    <input type="checkbox" value="" checked> Send me mail when the report published. <span>(Required)</span>
                                </label>
                            </div>
                        </div>*@
                    <div class="form-group">
                        <label for="email" class="col-sm-2 control-label"></label>
                        <div class="col-sm-10">
                            <label class="checbox-label">
                                <input type="checkbox" name="upcoming" id="chkNewRport" /> Send me mail when new report published in same category.
                            </label>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-xs-12">
                            <button type="submit" id="notifyme" class="btn btn-danger" style="margin:auto;display:block;">Notify Me</button>
                        </div>
                    </div>
                    @*<span style="margin: auto;display: block;width: 40px;font-size: 2em;">OR</span>
                        <div class="form-group">
                            <div class="col-xs-12">
                                <button type="button" id="btnlinkedin" class="btn btn-primary btn-lg" style="margin:auto;display:block;">Linked In</button>
                            </div>
                        </div>*@
                </form>
                @Scripts.Render("~/bundles/form-validation")
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>
</div>
<style>
    .checbox-label {
        width: 100%;
        cursor: pointer;
    }

    .checbox-label > input[type=checkbox] {
        width: 5%;
    }
</style>