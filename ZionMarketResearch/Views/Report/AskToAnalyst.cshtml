@model ZionMarketResearch.Models.MainPageReportView
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" id="ru" value="@ViewBag.ReportUrl" />
<div class="row" id="breadcrumb">
    <ul class="breadcrumb">
        <li><a href="/" rel="nofollow">Home</a></li>
        @foreach (string c in Model.Categories)
        {
            <li>@Html.Raw(c)</li>
        }
        <li>@Model.BreadCrumbTitle</li>
    </ul>
</div>

<div class="row">
    <div class="col-md-12">
        <h1 class="reporttitle">@Model.ReportTitle</h1>
        @if (!string.IsNullOrEmpty(Model.MetaDescription) && !Model.IsUpcoming)
        {
            <p class="title-summary">
                <i class="fa fa-quote-left"></i> @Model.MetaDescription <i class="fa fa-quote-right"></i>
            </p>
        }
        @{ Html.RenderPartial("_NewBuynowControl", Model);}
        <p>
            <strong style="color:#23527c;">@(!Model.IsUpcoming && Model.PublishedDate != null ? Html.Raw("<i class=\"fa fa-calendar\"></i> " + Model.PublishedDate.Value.ToString("dd-MMM-yyyy") + " |") : Html.Raw(""))  @(Model.NumberOfPages != null && Model.NumberOfPages > 0 ? Html.Raw("<i class=\"fa fa-file-text\" aria-hidden=\"true\"></i> Number of pages: " + Model.NumberOfPages.ToString() + " | ") : Html.Raw("")) <i class="fa fa-file-code-o" aria-hidden="true"></i> Report Code: ZMR-@Model.ReportId | Report Format : <i class="fa @ViewBag.DeliveryFormat"></i> | Status : @(Model.IsUpcoming ? "Upcoming" : "Published") @(Model.IsUpcoming ? Html.Raw("| <button type=\"button\" class=\"btn btn-danger btn-sm\" data-toggle=\"modal\" data-target=\"#myModal\">Notify Me</button>") : Html.Raw("") )</strong>
        </p>
    </div>
    <div class="col-sm-9">
        <div class="row" style="padding: 20px;">
            <h3 class="text-center">Ask For Analyst</h3>
            <div class="alert alert-info">
                <b>Please fill your details below, to receive analyst call:</b>
                <div style="font-size:15px;width:100%;"><label class="control-label required"></label> Indicates required fields</div>
            </div>
            @{ Html.RenderAction("ShowAskToAnalyst", "Form", new { FormType = 9, ReportId = ViewBag.ReportId }); }
        </div>
        <div class="row" id="relatedReports">
            <div class="margin-left-15">
                @{Html.RenderAction("RelatedReports", "Report", new { id = ZionMarketResearch.Util.Utility.Encryptstring(Model.ReportId.ToString()) });}
            </div>
        </div>
    </div>
    <div class="col-sm-3">
        @if (HttpContext.Current.Session["Discount"] != null)
        {<img class="img-responsive" style="margin-bottom:10px;" src="~/saleimages/blackFriday_small.png" alt="black friday sale" />}

        @{ Html.RenderPartial("_ChooseUs"); }
    </div>
    <div class="showPriceButton navbar navbar-fixed-bottom" style="background-color: transparent;color: white;text-align: center;">
        <button class="btn btn-danger" onclick="scrollToPrice('chooselicense')">
            Show Price
        </button>
    </div>
</div>
<style>
    .checbox-label {
        width: 100%;
        cursor: pointer;
    }

        .checbox-label > input[type=checkbox] {
            width: 5%;
        }


    #myAffix {
        padding-top: 20px;
    }

    .affix, .affix-top, .affix-bottom {
        right: 0;
        width: auto;
        z-index: 9999 !important;
        position: fixed;
        bottom: 250px;
    }

    @@media only screen and (max-device-width: 480px) and (min-device-width: 320px) {
        .col-sm-4 {
            display: block;
        }

        #relatedReports {
            display: none;
        }
    }

    @@media only screen and (min-device-width: 785px) {
        .showPriceButton {
            display: none;
        }
    }

    #content strong {
        color: #23527c;
    }
</style>
<script src="~/js/Report.js"></script>

<link href="~/css/BootstrapDatePicker/bootstrap-datetimepicker.min.css" rel="stylesheet" />
<script src="https://momentjs.com/downloads/moment.min.js"></script>
<script src="~/js/BootstrapDatePicker/bootstrap-datetimepicker.min.js"></script>
<script>
    function scrollToPrice(ctl) {
        $('html,body').animate({
            scrollTop: $('#' + ctl).offset().top - 50
        },
            'slow');
    }
</script>