@model ZionMarketResearch.Models.MainPageReportView
    
<section id="report-desc" class="container-fluid">
    <div class="row">
        <div class="col-md-9 col-sm-12">
            <div class="tab" role="tabpanel">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs">
                    <li role="presentation" class="active"><a data-target="Description" href="@Url.Action("Index", "Report", new { url = Model.ReportUrl })"><i class="fa fa-align-left" aria-hidden="true"></i> Description</a></li>
                    <li role="presentation">
                        <a data-target="TableOfContent" href="@Url.Action("TOC","Report", new { url = Model.ReportUrl })" rel="nofollow">
                            <i class="fa fa-list" aria-hidden="true"></i><span>Table of Content</span>
                        </a>
                    </li>
                    <li role="presentation"><a href="@Url.Action("Inquiry", "Report", new { url = Model.ReportUrl })" rel="nofollow"><i class="fa fa-shopping-cart" aria-hidden="true"></i>Buying Inquiry </a></li>
                    <li role="presentation"><a data-target="Methodology" href="@Url.Action("Methodology", "Report", new { url = Model.ReportUrl })" rel="nofollow"><i class="fa fa-file-text" aria-hidden="true"></i> Methodology </a></li>
                    @*<li role="presentation"><a data-target="FreeAnalysis" href="@Url.Action("Analysis", "Report", new { url = Model.ReportUrl })" aria-controls="messages" rel="nofollow"><i class="fa fa-file-text" aria-hidden="true"></i> Free Analysis </a></li>*@
                    <li role="presentation"><a style="background-color: #e00; color: #fff; " href="@Url.Action("Sample", "Report", new { url = Model.ReportUrl })" rel="nofollow"><i class="fa fa-paper-plane" aria-hidden="true"></i> Request Free Sample </a></li>

                </ul>
                <!-- Tab panes -->
                <div class="tab-content tabs">
                    <div role="tabpanel" class="tab-pane fade" id="Description" style="text-align:justify;">
                        <div id="Descriptionss">
                            @if (Request.QueryString["rs"] != null && Convert.ToBoolean(Request.QueryString["rs"]))
                            {
                                @Html.Raw(Model.ReSellerMainPageDescription);
                            }
                            else
                            {
                                if (Request.Path.Contains("/report/"))
                                {
                                    @Html.Raw(Model.MainPageDescription);
                                }
                            }
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane fade" id="TableOfContent" style="text-align:justify;">
                        <h3>Table Of Content</h3>
                        <div id="TableOfContentss">
                            @if (Request.Path.Contains("/toc/"))
                            {
                @Html.Raw(Model.TableOfContent) if (!string.IsNullOrEmpty(Model.ListOfFigures))
                                {
                <br />
                                    <h3>Table Of Figures</h3>
                                                        @Html.Raw(Model.ListOfFigures)}

                                                    if (!string.IsNullOrEmpty(Model.ListOfTabels))
                                                    {
                                    <br />
                                                        <h3>Table Of Tables</h3>
                                                                            @Html.Raw(Model.ListOfTabels)}
                                                                                        }
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane fade" id="Methodology" style="text-align:justify;">
                        <h3>Methodology</h3>
                        @if (Request.Path.Contains("/methodology/"))
                        {
            @Html.Raw(Model.Methodology)}
                    </div>
                    @if (!string.IsNullOrEmpty(Model.FreeAnalysis))
                    {
        <div role="tabpanel" class="tab-pane fade" id="FreeAnalysis" style="text-align:justify;">
            <h3>Free Analysis</h3>
            @if (Request.Path.Contains("/market-analysis/"))
            {
        @Html.Raw(Model.FreeAnalysis)}
        </div>}
                </div>
                @if (Context.User.Identity.Name != "")
                {
        <input type="button" value="Create" onclick="Save_TEST()" class="btn btn-default" />}
            </div>
            <!-- </div>
        </div>
    </div>-->
            @if (!Request.Path.Contains("/market-analysis/"))
            {
                if (Model.FAQ != null && Model.FAQ.Count > 0)
                {
                    <div class="grey_section section_gap">
                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-md-12">
                                    @{Html.RenderPartial("_FAQ");}
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }@*Show Review if FAQ is not availabel*@

        </div>
        <div class="col-sm-12 col-md-3">
            @{ Html.RenderPartial("_BuynowControlAnother"); }
            <div id="share_button" class="report-box">
                <a rel="nofollow" href="@Url.Action("RequestBrochure", "Report", new { url = Model.ReportUrl })"><p class="share_btn btn1 text-center">Request Free Brochure</p></a>
                <a rel="nofollow" href="@Url.Action("Index", "Custom", new { id = Model.ReportId })"><p class="share_btn btn2 text-center">Ask for Customization</p></a>
                <a rel="dofollow" href="@Url.Action("Analysis", "Report", new { url = Model.ReportUrl })"><p class="share_btn btn4 text-center">Free Analysis</p></a>
                <a rel="nofollow" href="@Url.Action("Inquiry", "Report", new { url = Model.ReportUrl })"><p class="share_btn btn5 text-center">Inquiry For Buying</p></a>
            </div>
            @*<div class="reportlist_box" style="cursor: pointer;">
            <a href="@Url.Action("Index", "Custom",new { id = Model.ReportId })?covid19=true" rel="nofollow" title="Request COVID 19 Impact">
                <img src="~/images/COVID-19.webp" class="img-responsive" width="270px" height="200px" alt="@Model.ReportTitle.Substring(0,Model.ReportTitle.IndexOf("Market")) Market COVID 19 Impact Analysis">
            </a>
        </div>*@
        <div class="TOCfix-div report-box">
            <div class="list-group" style="width:100%;">

                @Html.Raw(Model.MetaKeywordsTOC)

            </div>
        </div>
        </div>
        <!--<div class="col-sm-4">

        </div>-->
    </div>
</section>




@if (Model.RelatedNews != null && Model.RelatedNews.Count() > 0)
{
<section class="blue_section section_gap">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="heading">
                    <p class="faq-title top-heading"><span>Related</span>News</p>
                </div>
                <ul class="related-news">
                    @foreach (var n in Model.RelatedNews)
                    {

    <li>@Html.Raw(n)</li>}
                </ul>
            </div>
        </div>
    </div>
</section>}

