@model ZionMarketResearch.Models.MainPageReportView

<section id="report-desc" class="container-fluid">
    <div class="row">

        <div class="col-md-9 col-sm-12">

            <div class="tab" role="tabpanel">

                <ul class="nav nav-tabs">
                    <li class="active">
                        <a data-target="Description" href="@Url.Action("Index", "Report", new { url = Model.ReportUrl })">
                            <i class="fa fa-align-left"></i> Description
                        </a>
                    </li>

                    <li>
                        <a data-target="TableOfContent"
                           href="@Url.Action("TOC", "Report", new { url = Model.ReportUrl })"
                           rel="nofollow">
                            <i class="fa fa-list"></i>
                            <span>Table of Content</span>
                        </a>
                    </li>

                    <li>
                        <a href="@Url.Action("Inquiry", "Report", new { url = Model.ReportUrl })" rel="nofollow">
                            <i class="fa fa-shopping-cart"></i> Buying Inquiry
                        </a>
                    </li>

                    <li>
                        <a data-target="Methodology"
                           href="@Url.Action("Methodology", "Report", new { url = Model.ReportUrl })"
                           rel="nofollow">
                            <i class="fa fa-file-text"></i> Methodology
                        </a>
                    </li>

                    <li>
                        <a style="background-color:#e00;color:#fff;"
                           href="@Url.Action("Sample", "Report", new { url = Model.ReportUrl })"
                           rel="nofollow">
                            <i class="fa fa-paper-plane"></i> Request Free Sample
                        </a>
                    </li>
                </ul>

                <div class="tab-content tabs">

                    <div class="tab-pane fade" id="Description" style="text-align:justify;">
                        <div id="Descriptionss">
                            @if (Request.QueryString["rs"] != null && Convert.ToBoolean(Request.QueryString["rs"]))
                            {
                                @Html.Raw(Model.ReSellerMainPageDescription)
                            }
                            else if (Request.Path.Contains("/report/"))
                            {
                                @Html.Raw(Model.MainPageDescription)
                            }
                        </div>
                    </div>

                    <div class="tab-pane fade" id="TableOfContent" style="text-align:justify;">
                        <h3>Table Of Content</h3>

                        <div id="TableOfContentss">
                            @if (Request.Path.Contains("/toc/"))
                            {
                                @Html.Raw(Model.TableOfContent)

                                if (!string.IsNullOrEmpty(Model.ListOfFigures))
                                {
                                    <br />
                                    <h3>Table Of Figures</h3>
                                    @Html.Raw(Model.ListOfFigures)
                                }

                                if (!string.IsNullOrEmpty(Model.ListOfTabels))
                                {
                                    <br />
                                    <h3>Table Of Tables</h3>
                                    @Html.Raw(Model.ListOfTabels)
                                }
                            }
                        </div>
                    </div>

                    <div class="tab-pane fade" id="Methodology" style="text-align:justify;">
                        <h3>Methodology</h3>

                        @if (Request.Path.Contains("/methodology/"))
                        {
                            @Html.Raw(Model.Methodology)
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.FreeAnalysis))
                    {
                        <div class="tab-pane fade" id="FreeAnalysis" style="text-align:justify;">
                            <h3>Free Analysis</h3>

                            @if (Request.Path.Contains("/market-analysis/"))
                            {
                                @Html.Raw(Model.FreeAnalysis)
                            }
                        </div>
                    }

                </div>

                @if (Context.User.Identity.Name != "")
                {
                    <input type="button" value="Create" onclick="Save_TEST()" class="btn btn-default" />
                }

            </div>

            @if (!Request.Path.Contains("/market-analysis/") && Model.FAQ != null && Model.FAQ.Count > 0)
            {
                <div class="grey_section section_gap">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-md-12">
                                @{ Html.RenderPartial("_FAQ"); }
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>

        <div class="col-sm-12 col-md-3">

            @{ Html.RenderPartial("_BuynowControlAnother"); }

            <div id="share_button" class="report-box">
                <a rel="nofollow" href="@Url.Action("RequestBrochure", "Report", new { url = Model.ReportUrl })">
                    <p class="share_btn btn1 text-center">Request Free Brochure</p>
                </a>

                <a rel="nofollow" href="@Url.Action("Index", "Custom", new { id = Model.ReportId })">
                    <p class="share_btn btn2 text-center">Ask for Customization</p>
                </a>

                <a rel="dofollow" href="@Url.Action("Analysis", "Report", new { url = Model.ReportUrl })">
                    <p class="share_btn btn4 text-center">Free Analysis</p>
                </a>

                <a rel="nofollow" href="@Url.Action("Inquiry", "Report", new { url = Model.ReportUrl })">
                    <p class="share_btn btn5 text-center">Inquiry For Buying</p>
                </a>
            </div>

            <div class="TOCfix-div report-box">
                <div class="list-group" style="width:100%;">
                    @Html.Raw(Model.MetaKeywordsTOC)
                </div>
            </div>

        </div>

    </div>
</section>

@if (Model.RelatedNews != null && Model.RelatedNews.Count() > 0)
{
    <section class="blue_section section_gap">
        <div class="container">
            <div class="row">
                <div class="col-md-12">

                    <div class="heading">
                        <p class="faq-title top-heading">
                            <span>Related</span>News
                        </p>
                    </div>

                    <ul class="related-news">
                        @foreach (var n in Model.RelatedNews)
                        {
                            <li>@Html.Raw(n)</li>
                        }
                    </ul>

                </div>
            </div>
        </div>
    </section>
}