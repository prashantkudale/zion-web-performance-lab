@if (!Request.Browser.IsMobileDevice)
{
    <script>
        window.onscroll = function () {
            if (window.screen.width > 800) {
                myFunction();
            }
        };
        // Get the header
        var header = document.getElementById("reportButtons");

        // Get the offset position of the navbar
        var sticky = header.offsetTop;

        var buynow = document.getElementsByClassName('buynow-control');
        var buynowOffset = buynow[0].offsetHeight;

        // Get the offset position of the List of Contents
        var fixTOCTop = $('.TOCfix-div').offset().top;
        var testimonialOffset = $('.testimonialOffset').offset().top;


        // Add the sticky class to the header when you reach its scroll position. Remove "sticky" when you leave the scroll position
        function myFunction() {
            if (window.pageYOffset > sticky) {
                header.classList.add("sticky");
                header.classList.remove("row");
                header.classList.remove("hide");
            } else {
                header.classList.remove("sticky");
                header.classList.add("row");
                header.classList.add("hide");
            }
            if (window.pageYOffset > buynowOffset + 1000) {
                $(".buynow-control").addClass("sticky-right-sidebar");
            } else {
                $(".buynow-control").removeClass("sticky-right-sidebar");
            }

            if (window.pageYOffset > $(".buynow-control").parent()[0].offsetHeight + 1000) {
                $(".buynow-control").addClass('stick-to-bottm');
            } else {
                $(".buynow-control").removeClass('stick-to-bottm');
            }
            //console.log('fixTOCTop : ' + fixTOCTop + ' | window.pageYOffset : ' + window.pageYOffset);
            if (window.pageYOffset >= fixTOCTop && window.pageYOffset <= document.body.scrollHeight - 2000) {           // apply position: fixed if you
                $('.TOCfix-div').css({                      // scroll to that element or below it
                    position: 'fixed',
                    top: '75px',
                    right: '15px',
                    width: '22.7%'

                });
            } else {                                   // apply position: static
                $('.TOCfix-div').css({                      // if you scroll above it
                    position: 'static',
                    width: 'auto'
                });
            }
        }
    </script>
}

