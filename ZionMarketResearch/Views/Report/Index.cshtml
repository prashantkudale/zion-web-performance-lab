@model ZionMarketResearch.Models.MainPageReportView
@using ZionAdmin.Security
@using ZionMarketResearch.Models

@{
    Layout = "~/Views/Shared/_LayoutOneCss.cshtml";

    var smallTitleIndex = Model.ReportTitle.IndexOf(new string[] { " Market ", " Market:", " Market,", " Market-", ":" });

    var h1Title = smallTitleIndex > -1
        ? Model.ReportTitle.Substring(0, smallTitleIndex).Replace("Global ", string.Empty)
        : Model.ReportUrl.Replace("-", " ").ToProperCasing().Replace("Global", string.Empty).Replace(" Market", string.Empty);

    var h1Title1 = h1Title.Length > 94 ? h1Title.Substring(0, 93) : h1Title;

    var userIdentity = ((ZionAdmin.Security.CustomPrincipal)System.Web.HttpContext.Current.Session["User"]);
}

<style>
    #report-title {
        box-sizing: border-box;
    }

    @@media (max-width: 768px) {
        /* Reserve exact measured height */
        #report-title {
            min-height: 500px;
        }
    }
</style>
<section id="report-title" class="report-title-image white_section section_gap">

    @{ Html.RenderPartial("_NewSearch"); }

    <div class="container-fluid">

        @{
            Html.RenderPartial(
                "_breadcrumb",
                Html.Raw(Model.Categories[Model.Categories.Length - 1]) + "|" +
                (Model.ReportTitle.Contains("Market")
                    ? (Model.ReportTitle.Substring(0, Model.ReportTitle.IndexOf(new string[] { "Market ", "Market-", "Market:", "Market," })) + " Market")
                    : Model.ReportUrl.Replace("-", " ").ToProperCasing().Replace("Global", string.Empty).Replace(" Market", string.Empty) + " Market")
            );
        }

        <div id="heading-bg" style="position:relative;margin-bottom:8px;background:linear-gradient(355deg, rgba(23,66,173,1) 8%, rgba(29,106,156,1) 87%);font-size:16px;text-align:center;padding:20px 0 15px;">
            <h1 style="color:#ffffff;font-size:20px;">
                @if (!String.IsNullOrEmpty(Model.MetaKeywordsSample))
                {
                    @Html.Raw(Model.MetaKeywordsSample)
                }
                else if (Request.Path.Contains("/market-analysis/"))
                {
                    @h1Title1 @Html.Raw(" Market - Global Industry Analysis")
                }
                else
                {
                    @h1Title1 @Html.Raw(" Market Size, Share, Growth Report 2032")
                }
            </h1>
        </div>

        @{ Html.RenderPartial("_ReportInfo"); }

        <div class="row hide" id="reportButtons">
            <div class="container-fluid">

                <div class="col-sm-2">
                    <a href="/" style="text-decoration:none;border:none;">
                        <div class="logo">
                            <img src="~/images/zion-market-research-logo.png"
                                 class="img-responsive saturate1"
                                 width="104"
                                 height="56"
                                 title="Zion Market Research - @h1Title, Business Consulting Services &amp; Solutions"
                                 alt="Zion Market Research">
                        </div>
                    </a>
                </div>

                <div class="col-sm-8">
                    <p class="report-sticky-title" style="color:#024973;font-size:20px!important;margin:0;padding:22px 0;font-weight:700;font-family:'Montserrat',sans-serif!important;">
                        @h1Title1 Market
                    </p>
                </div>

                <div class="col-sm-2 zero-padding">
                    <div class="link-btn divright animate__animated animate__delay-1s animate__zoomIn" style="margin:25px 0 10px;">
                        <a rel="nofollow noreferrer"
                           href="@Url.Action("Sample", "Report", new { url = Model.ReportUrl })"
                           class="hvr-wobble-vertical pulse-button">
                            Request Free Sample
                        </a>
                    </div>
                </div>

            </div>
        </div>

    </div>

    @if (userIdentity != null && (userIdentity.IsInRole("Admin") || userIdentity.IsInRole("EditReport")))
    {
        <section class="container">
            <div class="row">
                <div class="col-md-12 text-center">
                    <button class="btn btn-primary" onclick="UpdateChanges()">Save</button>
                    <label style="color:black;">
                        <input type="checkbox" value="true" id="copyToReseller" />
                        Copy To Reseller?
                    </label>
                </div>
            </div>
        </section>
    }

</section>

@if (!Model.IsUpcoming)
{
    Html.RenderPartial("_PublishedReport", Model);
}
else
{
    Html.RenderPartial("_UpcomingReport", Model);
}

<script type="application/ld+json" data-structured-data>
[
    {
        "@@context": "https://schema.org",
        "@@graph": [
            {
                "@@type": "Dataset",
                "name": "@Model.ReportTitle",
                "temporalCoverage": "2022/2030",
                "spatialCoverage": "Global",
                "license": "https://www.zionmarketresearch.com/privacy-policy",
                "creator": {
                    "@@type": "Organization",
                    "url": "https://www.zionmarketresearch.com",
                    "name": "Zion Market Research"
                },
                "includedInDataCatalog": {
                    "@@type": "DataCatalog",
                    "name": "Zion Market Research",
                    "url": "https://www.zionmarketresearch.com"
                },
                "dateModified": "@DateTime.Now.AddDays(-10).ToString("yyyy-MM-dd")",
                "keywords": ["@Model.ReportTitle"],
                "url": "@String.Format("{0}{1}", "https://www.zionmarketresearch.com", Url.Action("Index", "Report", new { url = Model.ReportUrl }))",
                "sameAs": "@String.Format("{0}{1}", "https://www.zionmarketresearch.com", Url.Action("Index", "Report", new { url = Model.ReportUrl }))",
                "description": "@ViewBag.MetaDescription",
                "distribution": [
                    {
                        "@@type": "DataDownload",
                        "contentUrl": "@String.Format("{0}{1}", "https://www.zionmarketresearch.com", Url.Action("Sample", "Report", new { url = Model.ReportUrl }))",
                        "encodingFormat": "pdf"
                    }
                ]
            }
        ]
    }
]
</script>

<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "WebPage",
    "name": "@ViewBag.Title",
    "description": "@Model.MetaDescription",
    "thumbnailUrl": "@ViewBag.Firstimage"
}
</script>

