{
    "@@context": "https://schema.org",
    "@@type": "Article",
    "mainEntityOfPage": {
        "@@type": "WebPage",
        "@@id": "@Request.Url"
    },
    "headline": "@ViewBag.Title",
    "description": "@Model.MetaDescription",
    "image": {
        "@@type": "ImageObject",
        "url": "@ViewBag.Firstimage",
        "width": 2020,
        "height": 1156
    },
    "author": {
        "@@type": "Organization",
        "name": "Zion Market Research",
        "url": "https://www.zionmarketresearch.com/"
    },
    "publisher": {
        "@@type": "Organization",
        "name": "Zion Market Research",
        "logo": {
            "@@type": "ImageObject",
            "url": "https://www.zionmarketresearch.com/images/zion-market-research-logo.png"
        }
    },
    "datePublished": "@(Model.PublishedDate.HasValue ? Model.PublishedDate.Value.ToString("yyyy-MM-dd") : DateTime.Now.AddDays(-5).ToString("yyyy-MM-dd"))",
    "dateModified": "@(Model.PublishedDate.HasValue ? Model.PublishedDate.Value.ToString("yyyy-MM-dd") : DateTime.Now.AddDays(-5).ToString("yyyy-MM-dd"))"
