@if (Model.ReportId != null && Model.ReportId > 0)
{
    Html.RenderPartial("~/Views/Report/_PopForm.cshtml",
        new ZionMarketResearch.Models.AvailPDF
        {
            ReportId = (int)Model.ReportId,
            ReportTitle = Model.ReportTitle
        });
}

@section ReportIndexScripts {

    <script>
        $(function () {

            $(document).on('click', '.smooth-anchor', function (e) {
                e.preventDefault();

                var href = $(this).attr('href');
                var target = $.attr(this, 'href');

                if ($(target).length > 0 && href.length > 1 && href.indexOf('#') !== -1) {
                    $('html, body').animate({
                        scrollTop: $(target).offset().top - 100
                    }, 1000);
                }
            });

            try {
                var lastSegment = document.URL.split("/").slice(-2, -1)[0];

                var tabMap = {
                    'toc': 'TableOfContent',
                    'report': 'Description',
                    'methodology': 'Methodology',
                    'market-analysis': 'FreeAnalysis'
                };

                var targetTab = tabMap[lastSegment];

                if (targetTab) {
                    $('.nav-tabs a[data-target="' + targetTab + '"]').tab('show');
                    $("#" + targetTab).addClass("in active");
                }
            } catch (error) {
                var urlSegment = document.URL.split("/");
                if (urlSegment[urlSegment.length - 2] === 'report') {
                    $("#Description").addClass("in active");
                }
            }

            $('#Descriptionss img')
                .addClass('img-responsive')
                .removeAttr('style');

        });
    </script>

    @if (!Request.Browser.IsMobileDevice)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {

                var carousel = document.querySelector('#myclientCarousel');

                if (carousel && 'IntersectionObserver' in window) {
                    const observer = new IntersectionObserver(function (entries) {
                        if (entries[0].isIntersecting) {
                            $(carousel).carousel();
                            observer.disconnect();
                        }
                    });

                    observer.observe(carousel);
                }

            });
        </script>
    }

    @if (userIdentity != null && (userIdentity.IsInRole("Admin") || userIdentity.IsInRole("EditReport")))
    {
        <script defer src="/Areas/Admin/Content/js/ckeditor_4.11.3_standard/ckeditor/ckeditor.js"></script>

        <script>
            $(function () {

                var descriptionEditor = CKEDITOR.inline('Descriptionss');
                $("#Descriptionss").attr('contenteditable', 'true');

                function UpdateChanges() {
                    $.ajax({
                        url: '/updatereportdescription',
                        type: 'POST',
                        contentType: 'application/json; charset=utf-8',
                        data: JSON.stringify({
                            ReportID: @ZionMarketResearch.Util.Utility.Decryptstring(ViewBag.ReportID),
                            ReportDescription: descriptionEditor.getData(),
                            CopyToReseller: $("#copyToReseller").prop('checked')
                        }),
                        success: function (res) {
                            if (res > 0) alert('Report has been updated.');
                        },
                        error: function (err) {
                            console.log(err);
                        }
                    });
                }

            });
        </script>

        <script>
            $(function () {

                $('.buynow-button').on('click', function () {
                    let selected = 'su';
                    window.location.href = '/buynow/' + selected + '/@Model.ReportUrl';
                });

            });
        </script>

    }

}