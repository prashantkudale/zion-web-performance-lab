@model ZionMarketResearch.Models.MainPageReportView
@using ZionAdmin.Security;
@using ZionMarketResearch.Models;
@{ Layout = "~/Views/Shared/_LayoutOneCss.cshtml";
    var smallTitleIndex = Model.ReportTitle.IndexOf(new string[] { " Market ", " Market:", " Market,", " Market-", ":" });
    var h1Title = smallTitleIndex > -1 ? Model.ReportTitle.Substring(0, smallTitleIndex).Replace("Global ", string.Empty) : Model.ReportUrl.Replace("-", " ").ToProperCasing().Replace("Global", string.Empty).Replace(" Market", string.Empty);
    var h1Title1 = h1Title.Length > 94 ? h1Title.Substring(0, 93) : h1Title;
    var userIdentity = ((ZionAdmin.Security.CustomPrincipal)System.Web.HttpContext.Current.Session["User"]);

}

<section id="report-title" class="report-title-image white_section section_gap">
    @{ Html.RenderPartial("_NewSearch"); }
    <div class="container-fluid">
        @{ Html.RenderPartial("_breadcrumb", Html.Raw(Model.Categories[Model.Categories.Length - 1]) + "|" + (Model.ReportTitle.Contains("Market") ? (Model.ReportTitle.Substring(0, Model.ReportTitle.IndexOf(new string[] { "Market ", "Market-", "Market:", "Market," })) + " Market") : Model.ReportUrl.Replace("-", " ").ToProperCasing().Replace("Global", string.Empty).Replace(" Market", string.Empty) + " Market"));}
        <div id="heading-bg" style="position:relative; margin-bottom: 8px; background: rgb(23,66,173); background: linear-gradient(355deg, rgba(23,66,173,1) 8%, rgba(29,106,156,1) 87%); font-size: 16px; text-align: center; padding: 20px 0px 15px;">
            <h1 style="color:#ffffff; font-size:20px;">
                @if (!String.IsNullOrEmpty(Model.MetaKeywordsSample))
                {@Html.Raw(Model.MetaKeywordsSample) }
            else
            {
                if (Request.Path.Contains("/market-analysis/"))
                {@h1Title1 @Html.Raw(" Market - Global Industry Analysis")}
            else
            { @h1Title1 @Html.Raw(" Market Size, Share, Growth Report 2032")}
    }
            </h1>

        </div>
        @{ Html.RenderPartial("_ReportInfo"); }
        <div class="row hide" id="reportButtons">
            <div class="container-fluid">
                <div class="col-sm-2">
                    <a href="/" style="text-decoration:none;border:none;">
                        <div class="logo">
                            <img src="/images/zion-market-research-logo.png" class="img-responsive saturate1" width="104px" height="56px" title="Zion Market Research - @h1Title, Business Consulting Services &amp; Solutions" alt="Zion Market Research">
                        </div>
                    </a>
                </div>
                <div class="col-sm-8">
                    <p style="color: #024973; font-size: 20px !important; margin: 0px; padding: 22px 0px; font-weight: 700; font-family: 'Montserrat',sans-serif !important;"> @h1Title1 Market</p>
                </div>

                <div class="col-sm-2 zero-padding">
                    <div class="link-btn divright animate__animated animate__delay-1s animate__zoomIn" style="margin-bottom: 10px;margin-top:25px;">
                        @*<a rel="nofollow" href="@Url.Action("Index", "Custom", new { id = Model.ReportId })" class="hvr-wobble-vertical" rel="nofollow noreferrer">Request For Customization</a>*@
                        @*<a href="@Url.Action("RequestBrochure", "Report", new { url = Model.ReportUrl })" class="hvr-wobble-vertical" rel="nofollow noreferrer">Request Free Brochure</a>*@
                        <a rel="nofollow" href="@Url.Action("Sample", "Report" , new { url=Model.ReportUrl })" class="hvr-wobble-vertical pulse-button" rel="nofollow noreferrer">Request Free Sample</a>
                        @*<a rel="nofollow" href="@Url.Action(!Model.IsUpcoming ? "Index" : "Prebook" , "BuyNow" , new { url=Model.ReportUrl, reporttype="su" })" class="pulse-button" rel="nofollow noreferrer">@(!Model.IsUpcoming ? "Buy Now" : "Prebook") <i class="fa fa-arrow-right hvr-icon"></i></a>*@
                    </div>
                </div>
            </div>
        </div>
        @*<div class="row">
                <div class="col-md-12">
                    <div class="addthis_inline_share_toolbox" style="text-align:center"></div>
                </div>
            </div>*@
    </div>
    @if (userIdentity != null && (userIdentity.IsInRole("Admin") || userIdentity.IsInRole("EditReport")))
    {
        <section class="container">
            <div class="row">
                <div class="col-md-12" style="text-align:center;">
                    <button class="btn btn-primary" onclick="UpdateChanges()">Save</button>
                    <label style="color: black;"><input type="checkbox" value="true" id="copyToReseller" /> Copy To Reseller?</label>
                </div>
            </div>
        </section>}
</section>

@if (!Model.IsUpcoming)
{
    Html.RenderPartial("_PublishedReport", Model);
}
else if (Model.IsUpcoming)
