@model ZionMarketResearch.Models.MainPageReportView

<section id="report-desc" class="container-fluid">
    <div class="row">
        <div class="col-md-9 col-sm-12">
            <div class="tab" role="tabpanel">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active"><a data-toggle="tab"  role="tab" data-target="Description" href="@Url.Action("Index", "Report", new { url = Model.ReportUrl })" aria-controls="home" rel="nofollow"><i class="fa fa-align-left" aria-hidden="true"></i> Description</a></li>
                    <li role="presentation">
                        <a a data-toggle="tab"  role="tab" data-target="TableOfContent" href="@Url.Action("TOC","Report", new { url = Model.ReportUrl })" rel="nofollow" aria-controls="profile">
                            <i class="fa fa-list" aria-hidden="true"></i><span>Table of Content</span>
                        </a>
                    </li>
                    <!--<li role="presentation"><a href="@Url.Action("Sample", "Report", new { url = Model.ReportUrl })" aria-controls="messages" rel="nofollow"><i class="fa fa-paper-plane" aria-hidden="true"></i> Request Free Sample </a></li>-->
                    <li role="presentation"><a  data-toggle="tab"  role="tab" data-target="Buying Inquiry" href="@Url.Action("Inquiry", "Report", new { url = Model.ReportUrl })" aria-controls="messages" rel="nofollow"><i class="fa fa-shopping-cart" aria-hidden="true"></i>Buying Inquiry </a></li>
                    <li role="presentation"><a data-toggle="tab"  role="tab" data-target="Request Free Sample" style="background-color: #e00; color: #fff; " href="@Url.Action("Sample", "Report", new { url = Model.ReportUrl })" aria-controls="messages" rel="nofollow"><i class="fa fa-paper-plane" aria-hidden="true"></i> Request Free Sample </a></li>
                </ul>
                <!-- Tab panes -->
                <div class="tab-content tabs">
                    <div role="tabpanel" class="tab-pane fade" id="Description" style="text-align:justify;">
                        <h3>Description</h3>
                        <div id="Descriptionss">
                            @if (Request.QueryString["rs"] != null && Convert.ToBoolean(Request.QueryString["rs"]))
                            {
                @Html.Raw(Model.ReSellerMainPageDescription);
            }
            else
            {
@Html.Raw(Model.MainPageDescription);
}
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane fade" id="TableOfContent" style="text-align:justify;">
                        <h3>Table Of Content</h3>
                        @Html.Raw(Model.TableOfContent)
                        @if (!string.IsNullOrEmpty(Model.ListOfFigures))
                        {
            <br />
                            <h3>List Of Figures</h3>
                                            @Html.Raw(Model.ListOfFigures)}

                        @if (!string.IsNullOrEmpty(Model.ListOfTabels))
                        {
            <br />
                            <h3>Table Of Tables</h3>
                                            @Html.Raw(Model.ListOfTabels)}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-12 col-md-3">
            @{ Html.RenderPartial("_BuynowControlAnother"); }
            <div id="share_button" class="report-box">
                <a rel="nofollow" href="@Url.Action("RequestBrochure", "Report", new { url = Model.ReportUrl })"><p class="share_btn btn1 text-center">Request Free Brochure</p></a>
                <a rel="nofollow" href="@Url.Action("Index", "Custom", new { id = Model.ReportId })"><p class="share_btn btn2 text-center">Ask for Customization</p></a>
                <a rel="dofollow" href="@Url.Action("Analysis", "Report", new { url = Model.ReportUrl })"><p class="share_btn btn4 text-center">Free Analysis</p></a>
                <a rel="nofollow" href="@Url.Action("Inquiry", "Report", new { url = Model.ReportUrl })"><p class="share_btn btn5 text-center">Inquiry For Buying</p></a>
            </div>
            @*<div class="reportlist_box" style="cursor: pointer;">
            <a href="@Url.Action("Index", "Custom",new { id = Model.ReportId })?covid19=true" rel="nofollow" title="Request COVID 19 Impact">
                <img src="~/images/COVID-19.webp" class="img-responsive" alt="@Model.ReportTitle.Substring(0,Model.ReportTitle.IndexOf("Market")) Market COVID 19 Impact Analysis">
            </a>
        </div>*@
            <div class="TOCfix-div report-box">
                <div class="list-group" style="width:100%;">

                    @Html.Raw(Model.MetaKeywordsTOC)

                </div>
            </div>
        </div>
    </div>
</section>
@if (Model.RelatedNews != null && Model.RelatedNews.Count() > 0)
{
<section class="blue_section section_gap">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <ul>
                    @foreach (var n in Model.RelatedNews)
                    {
    @Html.Raw(n)
                        <li role="presentation"></li>
}
                </ul>
            </div>
        </div>
    </div>
</section>}
@if (Model.FAQ != null && Model.FAQ.Count > 0)
{
<section class="grey_section section_gap">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                @{Html.RenderPartial("_FAQ");}
            </div>
        </div>
    </div>
</section>}

