@model IEnumerable<ZionMarketResearch.Models.LatestUpComingReportView>
<div class="panel panel-primary">
    <div class="panel-heading"><strong><i class="fa fa-file-text" aria-hidden="true"></i> Latest Upcoming Reports</strong> <a href="/all-upcoming" class="white-text pull-right">View All Upcoming Reports</a></div>
    @foreach (var report in Model)
    {
        <div class="panel-body">
            <p>
                <i class="fa fa-th-large" aria-hidden="true"></i> @report.Categories[report.Categories.Length - 1]
                @if (HttpContext.Current.Session["Discount"] != null)
                { <span style="color:red;font-weight:bold;">Flat 30% Off</span> }
            </p>
            <a href="@Url.Action("Index", "Report", new { url = report.ReportUrl })">
                <h3>@report.ReportTitle</h3>
            </a>
            <blockquote>
                <p class="parasize">
                    @Html.DisplayFor(x => report.Description)
                    <span><a href="@Url.Action("Index", "Report", new { url = report.ReportUrl })" rel="nofollow">Read More <i class="fa fa-arrow-circle-right"></i></a></span>
                </p>
            </blockquote>
        </div>
    }
    <p class="read-more"><a href="@Url.Action("AllUpcoming", "Report")" rel="nofollow">View All Upcoming Reports <i class="fa fa-arrow-circle-right"></i></a></p>
</div>
