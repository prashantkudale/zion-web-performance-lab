@model PagedList.IPagedList<ZionMarketResearch.Models.SearchResultView>
@foreach (var report in Model)
{
<div class="heading reportlist_box">
    <div class="col-sm-10 zero-padding">
        <div class="topbadge">
            @if (report.PublishedDate != null)
            {<span class="badge"><i class="fa fa-calendar" aria-hidden="true"></i>  @report.PublishedDate.Value.ToString("MMM-yyyy") </span>}
            <span class="badge"> <i class="fa fa-tags" aria-hidden="true"></i> @(!report.IsUpcoming ? "Published" : "Upcoming")  </span>
        </div>
        <div class="row">
            <div class="col-sm-2">
                <img src="/images/report-img.png" alt="report icon" style="float:left;width:120px;border:1px solid #c5c5c5; margin-right:10px;margin-top:15px">
            </div>
            <div class="col-sm-10">
                <h2 class="reporttitle title-list-margin">
                    <a href="@Url.Action("Index", "Report", new { url = report.ReportUrl })">@report.ReportTitle</a>
                </h2>
                <p>
                    @ZionMarketResearch.Util.Utility.StripHTML(report.Description).ZSubstring(0, 299)
                </p>
                @if (report.Categories != null && report.Categories.Length > 0)
                {<span class="bottombadge reportTitle-readmore"><i class="fa fa-th-large" aria-hidden="true"></i> @Html.Raw(report.Categories[@report.Categories.Length - 1]) </span>} <span class="bottombadge"><i class="fa fa-file-pdf-o"></i> Report Format : PDF</span> <span class="bottombadge"> <i class="fa fa-book" aria-hidden="true"></i> Pages: @report.NumberOfPages </span>
                <span class="bottombadge reportTitle-readmore"> <a href="@Url.Action("Index", "Report", new { url = report.ReportUrl })" rel="nofollow">Read More <i class="fa fa-arrow-circle-right"></i></a></span>
            </div>
        </div>
    </div>
    <div class="col-sm-2 text-center lt-border">
        <div class="rb_btn">
            <h2> $ @report.SingleUser.Value.ToString("##") <small> Single User </small></h2>
            <a class="btn btn-warning btn-lg" href="@Url.Action(!report.IsUpcoming ? "Index" : "Prebook", "BuyNow", new { url = report.ReportUrl, reporttype="su" })" rel="nofollow"> @(!report.IsUpcoming ? "Buy Now" : "Prebook") </a>
        </div>
    </div>
</div>}
@*<style>
    .reportTitle-readmore {
        margin-left: 5px;
    }

        .reportTitle-readmore a {
            color: #024973;
            font-weight: bold;
        }

    .title-list-margin {
        margin-top: 19px !important;
    }
</style>*@